{%- doc -%}
  MARAMOUR — Enlaces secundarios del menú móvil.
  Se muestran debajo de los accesos principales: Mi cuenta, menú secundario
  (Preguntas frecuentes, Contacto…) e íconos de Facebook, Instagram y WhatsApp.

  @param {object} block_settings - Ajustes del bloque _header-menu
{%- enddoc -%}

{%- liquid
  assign secondary_menu = block_settings.secondary_menu
  assign facebook_url = block_settings.facebook_url
  assign instagram_url = block_settings.instagram_url
  assign whatsapp_url = block_settings.whatsapp_url
  assign show_account = false
  if block_settings.show_account_link and shop.customer_accounts_enabled
    assign show_account = true
  endif
  assign has_social = false
  if facebook_url != blank or instagram_url != blank or whatsapp_url != blank
    assign has_social = true
  endif
-%}

{%- if show_account or secondary_menu.links.size > 0 or has_social -%}
  <div class="mm-drawer-secondary">
    {%- if show_account or secondary_menu.links.size > 0 -%}
      <ul class="mm-drawer-secondary__list list-unstyled">
        {%- if show_account -%}
          <li>
            <a class="mm-drawer-secondary__link" href="{{ routes.account_url }}">Mi cuenta</a>
          </li>
        {%- endif -%}
        {%- for link in secondary_menu.links -%}
          <li>
            <a
              class="mm-drawer-secondary__link"
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if has_social -%}
      <ul class="mm-drawer-secondary__social list-unstyled">
        {%- if facebook_url != blank -%}
          <li>
            <a href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook de Maramour">
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                {%- render 'icon', icon: 'facebook' -%}
              </svg>
            </a>
          </li>
        {%- endif -%}
        {%- if instagram_url != blank -%}
          <li>
            <a href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram de Maramour">
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                {%- render 'icon', icon: 'instagram' -%}
              </svg>
            </a>
          </li>
        {%- endif -%}
        {%- if whatsapp_url != blank -%}
          <li>
            <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" aria-label="WhatsApp de Maramour">
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10 2a8 8 0 0 0-6.93 12L2 18l4.1-1.07A8 8 0 1 0 10 2Zm0 1.4a6.6 6.6 0 1 1-3.36 12.28l-.24-.14-2.43.64.65-2.37-.16-.25A6.6 6.6 0 0 1 10 3.4Z"/>
                <path d="M7.35 6.1c.18-.02.36 0 .48.28l.62 1.46c.07.17.05.36-.06.5l-.43.53a.3.3 0 0 0-.03.33 5.5 5.5 0 0 0 2.86 2.47.3.3 0 0 0 .33-.08l.5-.6a.43.43 0 0 1 .5-.12l1.43.68c.2.1.3.3.27.5-.08.66-.6 1.47-1.5 1.56-.62.06-1.42-.08-2.6-.68-1.6-.82-2.75-2.3-3.12-3.04-.45-.9-.4-1.66-.07-2.27.24-.43.5-.5.82-.52Z"/>
              </svg>
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}

  /* Íconos del menú: tres líneas y X más grande (20 px) */
  .header__icon--summary .header-drawer-icon,
  .header-drawer .menu-drawer__close-button .header-drawer-icon,
  .header__icon--summary .header-drawer-icon svg,
  .header-drawer .menu-drawer__close-button .header-drawer-icon svg {
    width: 20px;
    height: 20px;
  }

  .mm-drawer-secondary__social svg {
    width: 22px;
    height: 22px;
  }

  /* Enlaces secundarios justo debajo del menú principal (no al fondo del panel) */
  .header-drawer .menu-drawer__navigation-container {
    grid-template-rows: auto auto;
    align-content: start;
  }

  .header-drawer .menu-drawer__utility-links {
    margin-block: var(--padding-sm) var(--padding-lg);
  }
  /* Panel «Colección»: tarjetas 2 × 2 en formato vertical (moda), en lugar de 16:9 */
  .header-drawer .menu-drawer__link-image,
  .header-drawer
    .menu-drawer__menu--grid:has(.menu-drawer__link-image)
    .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image))::before {
    aspect-ratio: 4 / 5;
  }

  .header-drawer .menu-drawer__menu--grid {
    row-gap: var(--padding-lg);
  }

  /* Mientras una categoría no tenga foto, se reserva el mismo espacio 4:5
     (evita saltos de diseño y muestra la grilla real) */
  .header-drawer .menu-drawer__menu--grid .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image)) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    row-gap: var(--padding-3xs);
    padding: 0;
  }

  .header-drawer .menu-drawer__menu--grid .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image))::before {
    content: '';
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: rgb(var(--color-foreground-rgb) / 0.06);
    border-radius: var(--menu-image-border-radius);
  }

  /* Accesos principales: más contenidos que el 1.75rem de Horizon, con aire entre letras */
  .header-drawer .menu-drawer__menu-item--mainlist {
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    min-height: 52px;
  }

  .header-drawer .menu-drawer__menu--grid .menu-drawer__menu-item {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .mm-drawer-secondary {
    display: flex;
    flex-direction: column;
    gap: var(--padding-md);
    padding-block: var(--padding-lg) var(--padding-sm);
    border-block-start: 1px solid var(--color-border);
    margin-inline-end: var(--padding-xl);
  }

  .mm-drawer-secondary__list {
    display: flex;
    flex-direction: column;
  }

  .mm-drawer-secondary__link {
    display: flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.875rem;
    color: var(--color-foreground);
    text-decoration: none;
    opacity: 0.8;
  }

  .mm-drawer-secondary__link:hover,
  .mm-drawer-secondary__link[aria-current='page'] {
    opacity: 1;
  }

  .mm-drawer-secondary__social {
    display: flex;
    gap: var(--padding-xs);
    margin-inline-start: -10px;
  }

  .mm-drawer-secondary__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-foreground);
  }

  .mm-drawer-secondary__social svg {
    width: 20px;
    height: 20px;
  }
{% endstylesheet %}
