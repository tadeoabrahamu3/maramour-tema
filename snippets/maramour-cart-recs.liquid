{%- doc -%}
  MARAMOUR — Productos sugeridos dentro del carrito (vacío: «Más vendidos»; con productos:
  «Completá tu look»). Se arma en el servidor con la colección «mas-vendidos» (colección automática
  ordenada por «Más vendidos»); si no existe, usa todos los productos. Saltea agotados, tarjetas de
  regalo y lo que ya está en el carrito.
  Cada prenda: foto, nombre, precio y botón «Ver producto» (ahí elige color y talle).

  @param {string} heading - Título con líneas a los costados
  @param {string} [subheading] - Línea rosa debajo del título
  @param {number} [limit] - Cantidad de prendas (por defecto 3)
{%- enddoc -%}

{%- liquid
  assign limit = limit | default: 3
  assign source = collections['mas-vendidos']
  if source == blank or source.products_count == 0
    assign source = collections.all
  endif

  assign in_cart = cart.items | map: 'product_id' | join: ','
  assign in_cart = ',' | append: in_cart | append: ','

  assign shown = 0
-%}

{%- capture rows -%}
  {%- for item in source.products -%}
    {%- liquid
      if item.gift_card? or item.available == false
        continue
      endif
      assign key = ',' | append: item.id | append: ','
      if in_cart contains key
        continue
      endif
      assign shown = shown | plus: 1
    -%}
    <li class="mm-cr__item">
      <a class="mm-cr__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.featured_media -%}
          {{ item.featured_media.preview_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 225, 300', sizes: '110px', alt: '', class: 'mm-cr__img' }}
        {%- endif -%}
      </a>
      <div class="mm-cr__info">
        <a class="mm-cr__name" href="{{ item.url }}">{{ item.title | escape }}</a>
        <p class="mm-cr__price">
          {{ item.price | money_without_trailing_zeros }}
          {%- if item.compare_at_price > item.price -%}
            <s>{{ item.compare_at_price | money_without_trailing_zeros }}</s>
          {%- endif -%}
        </p>
        <a class="mm-cr__btn" href="{{ item.url }}">Ver producto</a>
      </div>
    </li>
    {%- if shown >= limit -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <div class="mm-cr">
    <div class="mm-cr__head">
      <p class="mm-cr__title">{{ heading }}</p>
      {%- if subheading != blank -%}<p class="mm-cr__sub">{{ subheading }}</p>{%- endif -%}
    </div>
    <ul class="mm-cr__list list-unstyled" role="list">{{ rows }}</ul>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ---------- Sugerencias en el carrito ---------- */
  .mm-cr {
    --mm-pink: #c2416c;

    width: 100%;
    margin-top: 28px;
    text-align: start;
  }

  .mm-cr__head {
    margin-bottom: 14px;
    text-align: center;
  }

  .mm-cr__title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .mm-cr__title::before,
  .mm-cr__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgb(var(--color-foreground-rgb) / 0.25);
  }

  .mm-cr__sub {
    margin: 4px 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--mm-pink);
  }

  .mm-cr__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .mm-cr__item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    align-items: center;
    padding: 14px;
    background: #f7f7f7;
    border-radius: 8px;
  }

  .mm-cr__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #efefef;
    border-radius: 6px;
  }

  .mm-cr__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .mm-cr__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .mm-cr__name {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
  }

  .mm-cr__price {
    display: flex;
    gap: 8px;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .mm-cr__price s {
    font-weight: 400;
    color: var(--mm-pink);
  }

  .mm-cr__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    margin-top: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    text-decoration: none;
    text-transform: uppercase;
    background: transparent;
    border: 1px solid var(--color-foreground);
    border-radius: 8px;
  }

  .mm-cr__btn:hover {
    color: #fff;
    background: var(--color-foreground);
  }

  /* ---------- Carrito vacío ---------- */
  .mm-cart-empty-default .cart-items__wrapper--drawer-empty > * {
    display: none !important;
  }

  .mm-cart-empty-default {
    padding: 0 !important;
  }

  .cart-drawer--empty .cart-drawer__content,
  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    justify-content: flex-start;
  }

  /* Encabezado «Carrito (N productos)» y X como en el menú */
  .mm-cart-title {
    gap: 8px;
    align-items: baseline;
    font-size: 1.375rem;
    font-weight: 700;
  }

  .mm-cart-title__count {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  #cart-drawer .theme-drawer__close-button {
    width: 40px;
    height: 40px;
    margin-inline-end: -10px;
    color: var(--color-foreground);
    background: none !important;
    border: 0;
    box-shadow: none;
  }

  #cart-drawer .theme-drawer__close-button svg {
    width: 20px;
    height: 20px;
  }

  .cart-drawer--empty .theme-drawer__header,
  .cart-drawer__inner:has(.mm-cart-title--empty) > .theme-drawer__header {
    position: relative;
    z-index: 2;
  }

  .mm-cart-title--empty {
    position: absolute;
    top: var(--theme-drawer-padding, 20px);
    left: var(--cart-drawer-padding, 20px);
    z-index: 1;
    min-height: 40px;
    align-items: center;
  }

  .cart-drawer__inner {
    position: relative;
  }

  .mm-cart-empty__text {
    width: 100%;
    margin: 24px 0 0;
    padding-inline: var(--cart-drawer-padding);
    font-size: 0.9375rem;
    text-align: center;
  }

  .mm-cart-empty {
    width: 100%;
    padding: 0 var(--cart-drawer-padding) 24px;
  }

  .mm-cart-empty .mm-cr {
    margin-top: 20px;
  }

  .mm-cart-empty__all {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 20px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    background: #111;
    border-radius: 4px;
  }

  /* ---------- Carrito con productos ---------- */
  /* «Completá tu look»: de borde a borde del carrito */
  .cart-drawer__items .mm-cr {
    width: auto;
    margin: 28px calc(-1 * var(--cart-drawer-padding)) 8px;
  }

  .cart-drawer__items .mm-cr__title {
    font-size: 1rem;
  }

  .cart-drawer__items .mm-cr__title::before,
  .cart-drawer__items .mm-cr__title::after {
    background: var(--color-foreground);
  }

  .cart-drawer__items .mm-cr__list {
    gap: 6px;
  }

  .cart-drawer__items .mm-cr__item {
    padding: 14px var(--cart-drawer-padding);
    border-radius: 0;
  }

  /* Productos del carrito: foto 2:3 con X para quitar, nombre 12 px, color/talle/precio 11 px */
  .cart-drawer__items .cart-items__table-row--full-width-variants {
    grid-template-columns: 84px minmax(0, 1fr);
    grid-template-areas:
      'media details'
      'media unit_price'
      'media variants'
      'media quantity'
      'media error';
    column-gap: 16px;
  }

  .cart-drawer__items .cart-items__media {
    position: relative;
    width: 84px;
  }

  .cart-drawer__items .cart-items__table-row--full-width-variants .cart-items__unit-price-wrapper {
    font-size: 0.6875rem;
  }

  .cart-drawer__items .cart-items__quantity {
    margin-top: 8px;
  }

  /* Cantidad compacta, al tono del texto chico */
  #cart-drawer .cart-items .quantity-selector {
    --quantity-selector-width: 84px;

    width: var(--quantity-selector-width);
    height: 28px;
    font-size: 0.75rem;
    border: 0 !important;
    border-radius: 0;
    box-shadow: none !important;
    background: transparent;
  }

  #cart-drawer .cart-items .quantity-selector button {
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  #cart-drawer .cart-items .quantity-selector button:hover {
    color: var(--color-foreground);
  }

  #cart-drawer .cart-items .quantity-selector input[type='number'] {
    border-inline: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  #cart-drawer .cart-items .quantity-selector button {
    width: 28px;
    height: 28px;
  }

  #cart-drawer .cart-items .quantity-selector button svg {
    width: 10px;
    height: 10px;
  }

  #cart-drawer .cart-items .quantity-selector input[type='number'] {
    width: calc(var(--quantity-selector-width) - 56px);
    font-size: 0.75rem;
  }

  .cart-drawer__items .cart-items__media-container {
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    background: #f7f7f7;
  }

  .cart-drawer__items .cart-items__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* «Eliminar» como texto subrayado al lado de la cantidad */
  .mm-line-remove {
    padding: 4px 0;
    font: inherit;
    font-size: 0.6875rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
    text-decoration: underline;
    text-underline-offset: 3px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .mm-line-remove:hover {
    color: var(--color-foreground);
  }

  .cart-drawer__items .cart-items__quantity-controls {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cart-drawer__items .cart-items__remove,
  .cart-drawer__items .cart-items__price {
    display: none !important;
  }

  .cart-drawer__items .cart-items__title {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .cart-drawer__items .cart-items__variants {
    display: grid;
    gap: 2px;
  }

  .cart-drawer__items .cart-items__variant,
  .cart-drawer__items .cart-items__unit-price-wrapper {
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-foreground) !important;
  }

  .cart-drawer__items .cart-items__variant *,
  .cart-drawer__items .cart-items__unit-price-wrapper * {
    color: inherit !important;
  }

  .cart-drawer__items .cart-items__unit-price-wrapper {
    margin-block: 2px 4px;
  }

  .cart-drawer__items .cart-items__variant *,
  .cart-drawer__items .cart-items__unit-price-wrapper * {
    font-size: inherit !important;
  }

  .mm-variant-line {
    display: flex;
    gap: 4px;
  }

  .mm-variant-line dt,
  .mm-variant-line dd {
    margin: 0;
  }



  .mm-cart-ship-wrap {
    padding: 4px var(--cart-drawer-padding) 16px;
  }

  /* Resumen: solo «Subtotal» y el botón (sin «Total estimado» ni aclaración de impuestos) */
  .mm-subtotal {
    display: none;
  }

  #cart-drawer .mm-subtotal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 0.875rem;
    font-weight: 700;
  }

  #cart-drawer .cart-totals__container {
    display: none;
  }

  #cart-drawer .cart-totals:not(:has(.cart-actions)) {
    padding-block-start: 16px;
  }

  #cart-drawer .cart__checkout-button {
    min-height: 48px;
    height: 48px;
    border-radius: 4px;
    background: #111;
  }

  #cart-drawer .cart__checkout-button .button-text,
  .cart__checkout-button .button-text {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mm-cart-note {
    margin: 10px 0 0;
    font-size: 0.75rem;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .mm-transfer-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 6px;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  .mm-transfer-total > span:last-child {
    font-weight: 600;
    color: #c2416c;
  }

  .mm-transfer-total__badge {
    display: inline-block;
    margin-left: 4px;
    padding: 1px 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #c2416c;
    background: #f9e3e8;
    border-radius: 4px;
  }

  /* Botón «Pagar con transferencia» de la app Scala Discounts: secundario, con borde,
     para que no compita con «Finalizar compra» */
  scala-cart-button {
    display: block;
    width: 100%;
    margin-top: 10px;
  }

  scala-cart-button::part(actualbutton) {
    width: 100%;
    height: 50px;
    color: #141414;
    font-weight: 600;
    background: #fff;
    border: 1px solid #141414;
    transition: background 0.2s ease;
  }

  scala-cart-button::part(actualbutton):hover {
    background: #f7f7f7;
  }

  .mm-cart-savings {
    margin-bottom: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1f7a3a;
  }
{% endstylesheet %}
