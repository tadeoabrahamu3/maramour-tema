{%- doc -%}
  MARAMOUR — Productos sugeridos dentro del carrito (vacío: «Más vendidos»; con productos:
  «Completá tu look»). Se arma en el servidor con la colección «mas-vendidos» (colección automática
  ordenada por «Más vendidos»); si no existe, usa todos los productos. Saltea agotados, tarjetas de
  regalo y lo que ya está en el carrito.
  Compra rápida: en vez de un botón «Agregar» (en ropa falta elegir el talle), cada prenda muestra
  sus colores y talles disponibles; tocar un talle la agrega al carrito (assets/maramour-cart.js).

  @param {string} heading - Título con líneas a los costados
  @param {string} [subheading] - Línea rosa debajo del título
  @param {number} [limit] - Cantidad de prendas (por defecto 3)
{%- enddoc -%}

{%- liquid
  assign limit = limit | default: 3
  assign source = collections['mas-vendidos']
  if source == blank or source.products_count == 0
    assign source = collections.all
  endif

  assign in_cart = cart.items | map: 'product_id' | join: ','
  assign in_cart = ',' | append: in_cart | append: ','

  assign shown = 0
-%}

{%- capture rows -%}
  {%- for item in source.products -%}
    {%- liquid
      if item.gift_card? or item.available == false
        continue
      endif
      assign key = ',' | append: item.id | append: ','
      if in_cart contains key
        continue
      endif

      assign color_index = -1
      assign size_index = -1
      for opt in item.options_with_values
        assign n = opt.name | downcase
        if n contains 'color' or n contains 'colour'
          assign color_index = forloop.index0
        elsif size_index == -1
          assign size_index = forloop.index0
        endif
      endfor

      assign names = ''
      assign hexes = ''
      for entry in item.metafields.shopify['color-pattern'].value
        assign names = names | append: entry.label.value | downcase | append: '|'
        assign hexes = hexes | append: entry.color.value | append: '|'
      endfor
      assign names = names | split: '|'
      assign hexes = hexes | split: '|'

      assign first = item.selected_or_first_available_variant
      assign shown = shown | plus: 1
      assign uid = 'mm-qa-' | append: item.id | append: '-' | append: shown
    -%}
    <li class="mm-cr__item" data-mm-qa>
      <a class="mm-cr__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.featured_media -%}
          {{ item.featured_media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '88px', alt: '', class: 'mm-cr__img' }}
        {%- endif -%}
      </a>
      <div class="mm-cr__info">
        {%- if item.type != blank -%}<p class="mm-cr__kicker">{{ item.type | escape }}</p>{%- endif -%}
        <a class="mm-cr__name" href="{{ item.url }}">{{ item.title | escape }}</a>
        <p class="mm-cr__price">
          {{ item.price | money_without_trailing_zeros }}
          {%- if item.compare_at_price > item.price -%}
            <s>{{ item.compare_at_price | money_without_trailing_zeros }}</s>
          {%- endif -%}
        </p>

        {%- if item.has_only_default_variant -%}
          <button type="button" class="mm-cr__add" data-mm-qa-add="{{ first.id }}">Agregar al carrito</button>
        {%- else -%}
          {%- if color_index > -1 and item.options_with_values[color_index].values.size > 1 -%}
            <div class="mm-cr__colors" role="radiogroup" aria-label="Color">
              {%- for value in item.options_with_values[color_index].values -%}
                {%- liquid
                  assign vkey = value | downcase
                  assign hex = '#ddd'
                  for nm in names
                    if nm == vkey
                      assign hex = hexes[forloop.index0]
                      break
                    endif
                  endfor
                  assign color_available = false
                  for v in item.variants
                    if v.options[color_index] == value and v.available
                      assign color_available = true
                      break
                    endif
                  endfor
                -%}
                {%- if color_available -%}
                  <button
                    type="button"
                    class="mm-cr__color"
                    role="radio"
                    aria-checked="{% if first.options[color_index] == value %}true{% else %}false{% endif %}"
                    aria-label="{{ value | escape }}"
                    title="{{ value | escape }}"
                    style="--mm-sw: {{ hex }};"
                    data-mm-qa-color="{{ value | escape }}"
                  ></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} Un grupo de talles por color; se ve el del color elegido {%- endcomment -%}
          {%- liquid
            if color_index > -1
              assign groups = item.options_with_values[color_index].values
            else
              assign groups = 'all' | split: ','
            endif
          -%}
          {%- for group in groups -%}
            <div class="mm-cr__sizes" data-mm-qa-group="{{ group | escape }}"{% if color_index > -1 and first.options[color_index] != group %} hidden{% endif %}>
              <span class="mm-cr__sizes-label">Talle</span>
              {%- for v in item.variants -%}
                {%- liquid
                  if color_index > -1 and v.options[color_index] != group
                    continue
                  endif
                  if size_index > -1
                    assign size_label = v.options[size_index]
                  else
                    assign size_label = v.title
                  endif
                -%}
                <button
                  type="button"
                  class="mm-cr__size"
                  data-mm-qa-add="{{ v.id }}"
                  aria-label="Agregar talle {{ size_label | escape }}"
                  {% unless v.available %}disabled{% endunless %}
                >
                  {{- size_label | escape -}}
                </button>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
        <p class="mm-cr__msg" data-mm-qa-msg role="status" aria-live="polite"></p>
      </div>
    </li>
    {%- if shown >= limit -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <div class="mm-cr">
    <div class="mm-cr__head">
      <p class="mm-cr__title">{{ heading }}</p>
      {%- if subheading != blank -%}<p class="mm-cr__sub">{{ subheading }}</p>{%- endif -%}
    </div>
    <ul class="mm-cr__list list-unstyled" role="list">{{ rows }}</ul>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ---------- Sugerencias en el carrito ---------- */
  .mm-cr {
    --mm-pink: #c2416c;

    width: 100%;
    margin-top: 28px;
    text-align: start;
  }

  .mm-cr__head {
    margin-bottom: 14px;
    text-align: center;
  }

  .mm-cr__title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .mm-cr__title::before,
  .mm-cr__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgb(var(--color-foreground-rgb) / 0.25);
  }

  .mm-cr__sub {
    margin: 4px 0 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--mm-pink);
  }

  .mm-cr__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .mm-cr__item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 14px;
    align-items: start;
    padding: 12px;
    background: #f7f5f3;
    border-radius: 8px;
  }

  .mm-cr__media {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: #eee;
    border-radius: 4px;
  }

  .mm-cr__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-cr__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-top: 2px;
  }

  .mm-cr__kicker {
    margin: 0;
    font-size: 0.6875rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .mm-cr__name {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
  }

  .mm-cr__price {
    display: flex;
    gap: 6px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .mm-cr__price s {
    font-weight: 400;
    color: var(--mm-pink);
  }

  .mm-cr__colors {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .mm-cr__color {
    width: 20px;
    height: 20px;
    padding: 0;
    background: var(--mm-sw, #ddd);
    border: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
    cursor: pointer;
  }

  .mm-cr__color[aria-checked='true'] {
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--color-foreground);
  }

  .mm-cr__sizes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
  }

  .mm-cr__sizes[hidden] {
    display: none;
  }

  .mm-cr__sizes-label {
    flex-basis: 100%;
    font-size: 0.6875rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .mm-cr__size,
  .mm-cr__add {
    min-width: 36px;
    height: 32px;
    padding: 0 8px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-foreground);
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 4px;
    cursor: pointer;
  }

  .mm-cr__add {
    width: 100%;
    max-width: 200px;
    margin-top: 6px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mm-cr__size:not(:disabled):hover,
  .mm-cr__add:hover {
    border-color: var(--color-foreground);
  }

  .mm-cr__size:disabled {
    color: rgb(var(--color-foreground-rgb) / 0.35);
    text-decoration: line-through;
    cursor: default;
  }

  .mm-cr__size.is-loading,
  .mm-cr__add.is-loading {
    color: #fff;
    background: var(--color-foreground);
  }

  .mm-cr__msg {
    margin: 0;
    font-size: 0.6875rem;
    color: var(--mm-pink);
  }

  .mm-cr__msg:empty {
    display: none;
  }

  /* ---------- Carrito vacío ---------- */
  .mm-cart-empty-default .cart-items__wrapper--drawer-empty > * {
    display: none !important;
  }

  .mm-cart-empty-default {
    padding: 0 !important;
  }

  .cart-drawer--empty .cart-drawer__content,
  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    justify-content: flex-start;
  }

  .cart-drawer__content:has(.mm-cart-empty) #cart-drawer-heading {
    margin: 8px 0 0;
    padding-inline: var(--cart-drawer-padding);
    font-size: 0.9375rem;
    font-weight: 400;
    text-align: center;
  }

  .mm-cart-empty {
    width: 100%;
    padding: 0 var(--cart-drawer-padding) 24px;
  }

  .mm-cart-empty .mm-cr {
    margin-top: 20px;
  }

  .mm-cart-empty__all {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 20px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    background: #111;
    border-radius: 4px;
  }

  /* ---------- Carrito con productos ---------- */
  .cart-drawer__items .mm-cr {
    margin-bottom: 8px;
  }

  .mm-cart-ship-wrap {
    padding: 4px var(--cart-drawer-padding) 16px;
  }

  .cart__checkout-button .button-text {
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mm-cart-note {
    margin: 10px 0 0;
    font-size: 0.75rem;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .mm-cart-savings {
    margin-bottom: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1f7a3a;
  }
{% endstylesheet %}
