{%- doc -%}
  MARAMOUR — Barra de envío gratis en el carrito. Umbral: $100.000 (mismo valor que la tarifa de
  envío gratis configurada en Shopify → Envíos). Si cambia, actualizar `threshold` (en centavos).
{%- enddoc -%}

{%- liquid
  assign threshold = 10000000
  assign total = cart.total_price
  assign missing = threshold | minus: total
  assign pct = total | times: 100.0 | divided_by: threshold
  if pct > 100
    assign pct = 100
  endif
-%}

<div class="mm-ship{% if missing <= 0 %} mm-ship--done{% endif %}">
  <p class="mm-ship__text" role="status">
    {%- if missing > 0 -%}
      ¡Te faltan <strong>{{ missing | money_without_trailing_zeros }}</strong> para tener <strong>envío gratis</strong>!
    {%- else -%}
      ¡Tu compra tiene <strong>envío gratis</strong>!
    {%- endif -%}
  </p>
  <div class="mm-ship__bar" aria-hidden="true">
    <span class="mm-ship__fill" style="width: {{ pct }}%;"></span>
    <span class="mm-ship__icon">
      <svg viewBox="0 0 20 20" fill="none"><path d="M3 6.5 10 3l7 3.5v7L10 17l-7-3.5v-7Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M3 6.5 10 10l7-3.5M10 10v7M6.5 4.75l7 3.5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
    </span>
  </div>
</div>

{% stylesheet %}
  .mm-ship__text {
    margin: 0 0 10px;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .mm-ship__bar {
    position: relative;
    height: 6px;
    margin-inline-end: 14px;
    background: rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 99px;
  }

  .mm-ship__fill {
    display: block;
    height: 100%;
    background: #c2416c;
    border-radius: inherit;
    transition: width 0.4s ease;
  }

  .mm-ship__icon {
    position: absolute;
    top: 50%;
    right: -14px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: #c2416c;
    background: #fff;
    border: 1.5px solid #c2416c;
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .mm-ship__icon svg {
    width: 16px;
    height: 16px;
  }

  .mm-ship--done .mm-ship__icon {
    color: #fff;
    background: #c2416c;
  }
{% endstylesheet %}
