{%- doc -%}
  MARAMOUR — Barra de envío gratis en el carrito. Umbral: $100.000 (mismo valor que la tarifa de
  envío gratis configurada en Shopify → Envíos). Si cambia, actualizar `threshold` (en centavos).
{%- enddoc -%}

{%- liquid
  assign threshold = 10000000
  assign total = cart.total_price
  assign missing = threshold | minus: total
  assign pct = total | times: 100.0 | divided_by: threshold
  if pct > 100
    assign pct = 100
  endif
-%}

<div class="mm-ship{% if missing <= 0 %} mm-ship--done{% endif %}">
  <p class="mm-ship__text" role="status">
    {%- if missing > 0 -%}
      ¡Te faltan <strong>{{ missing | money_without_trailing_zeros }}</strong> para tener <strong>envío gratis</strong>!
    {%- else -%}
      ¡Tu compra tiene <strong>envío gratis</strong>!
    {%- endif -%}
  </p>
  <div class="mm-ship__bar" aria-hidden="true">
    <span class="mm-ship__fill" style="width: {{ pct }}%;"></span>
    <span class="mm-ship__icon">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 3.5 28 9v14l-12 5.5L4 23V9l12-5.5Z" fill="#c98a4b"/>
        <path d="M16 3.5 28 9l-12 5.5L4 9l12-5.5Z" fill="#e2ad6d"/>
        <path d="M16 14.5V28.5L4 23V9l12 5.5Z" fill="#b5763a"/>
        <path d="M9.8 6.3 22 11.9v5.3l-3 1.4v-5.3L6.8 7.7l3-1.4Z" fill="#f3d9a8"/>
        <path d="M16 14.5 28 9M16 14.5 4 9M16 14.5v14" stroke="#8f5a2a" stroke-width=".6" stroke-opacity=".5" fill="none"/>
      </svg>
    </span>
  </div>
</div>

{% stylesheet %}
  .mm-ship__text {
    margin: 0 0 10px;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .mm-ship__bar {
    position: relative;
    height: 6px;
    margin-inline-end: 16px;
    background: rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 99px;
  }

  .mm-ship__fill {
    display: block;
    height: 100%;
    background: #c2416c;
    border-radius: inherit;
    transition: width 0.4s ease;
  }

  .mm-ship__icon {
    position: absolute;
    top: 50%;
    right: -16px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    background: #fff;
    border: 2px solid #e9a3b8;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.08);
    transform: translateY(-50%);
  }

  .mm-ship__icon svg {
    width: 22px;
    height: 22px;
  }

  .mm-ship--done .mm-ship__icon {
    border-color: #c2416c;
  }
{% endstylesheet %}
