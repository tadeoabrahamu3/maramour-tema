{%- doc -%}
  MARAMOUR — Tarjeta de producto de la tienda (colecciones).
  Fotos deslizables (solo las del color elegido + las que no tienen color en el texto alternativo,
  igual que en la página de producto), nombre, precio, cuotas, precio con transferencia y colores.
  Tocar un color cambia las fotos por las de ese color y el enlace abre la prenda en ese color.

  @param {object} product - Producto
  @param {boolean} [featured] - Tarjeta grande (una sola columna, foto completa)
  @param {string} [loading] - 'lazy' (por defecto) o 'eager'
  @param {number} [installments] - Cuotas sin interés (por defecto 3)
  @param {number} [transfer_discount] - % de descuento por transferencia (por defecto 10)
  @param {string} [preferred_color] - Color a mostrar primero (por ejemplo el del filtro activo)
{%- enddoc -%}

{%- liquid
  assign n = installments | default: 3
  assign pct = transfer_discount | default: 10
  assign keep = 100 | minus: pct
  assign price = product.price
  assign cuota = price | divided_by: n | divided_by: 100 | times: 100
  assign transfer = price | times: keep | divided_by: 10000 | times: 100
  assign img_loading = loading | default: 'lazy'
  assign fp = 'auto'
  if img_loading == 'eager'
    assign fp = 'high'
  endif
  if featured
    assign sizes = '(min-width: 750px) 50vw, 100vw'
    assign widths = '450, 600, 750, 900, 1100, 1300'
  else
    assign sizes = '(min-width: 750px) 25vw, 50vw'
    assign widths = '300, 450, 600, 750'
  endif

  assign first = product.featured_media

  assign color_opt = product.options_with_values | where: 'name', 'Color' | first
  assign color_index = -1
  if color_opt
    assign color_index = color_opt.position | minus: 1
  endif

  comment
    Color activo: el preferido (filtro) si existe, si no el de la foto principal, si no el primero.
  endcomment
  assign active = ''
  if color_opt
    assign pref = preferred_color | downcase | strip
    for value in color_opt.values
      assign k = value | downcase | strip
      if k == pref and pref != blank
        assign active = k
        break
      endif
    endfor
    if active == blank
      assign falt = first.alt | downcase | strip
      for value in color_opt.values
        assign k = value | downcase | strip
        assign pre = falt | slice: 0, k.size
        if pre == k and k.size > active.size
          assign active = k
        endif
      endfor
    endif
    if active == blank
      assign active = color_opt.values.first | downcase | strip
    endif
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<article class="mm-pc{% if featured %} mm-pc--featured{% endif %}" data-mm-pc>
  <div class="mm-pc__media"{% if featured and first %} style="--mm-ar: {{ first.aspect_ratio | default: 0.6667 }};"{% endif %}>
    <div class="mm-pc__track" data-mm-pc-track>
      {%- assign shown_slides = 0 -%}
      {%- for media in product.media limit: 24 -%}
        {%- liquid
          if media.preview_image == blank
            continue
          endif
          assign mkey = ''
          if color_opt
            assign malt = media.alt | downcase | strip
            for value in color_opt.values
              assign k = value | downcase | strip
              assign pre = malt | slice: 0, k.size
              if pre == k and k.size > mkey.size
                assign mkey = k
              endif
            endfor
          endif
          assign is_hidden = false
          if mkey != blank and mkey != active
            assign is_hidden = true
          endif
          assign slide_loading = 'lazy'
          assign slide_fp = 'auto'
          if is_hidden == false
            assign shown_slides = shown_slides | plus: 1
            if shown_slides == 1
              assign slide_loading = img_loading
              assign slide_fp = fp
            endif
          endif
        -%}
        <a
          class="mm-pc__slide"
          href="{{ product.url }}"
          data-mm-pc-link
          data-color="{{ mkey | escape }}"
          tabindex="-1"
          {% if is_hidden %}hidden{% endif %}
        >
          {{
            media.preview_image
            | image_url: width: 1300
            | image_tag:
              loading: slide_loading,
              fetchpriority: slide_fp,
              widths: widths,
              sizes: sizes,
              class: 'mm-pc__img',
              alt: product.title
          }}
        </a>
      {%- else -%}
        <a class="mm-pc__slide" href="{{ product.url }}" data-mm-pc-link>
          {{ 'product-apparel-1' | placeholder_svg_tag: 'mm-pc__img' }}
        </a>
      {%- endfor -%}
    </div>

    <button type="button" class="mm-pc__arrow mm-pc__arrow--prev" data-mm-pc-prev aria-label="Foto anterior">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m12 5-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="mm-pc__arrow mm-pc__arrow--next" data-mm-pc-next aria-label="Foto siguiente">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="mm-pc__dots" data-mm-pc-dots aria-hidden="true"></div>

    {%- if product.available == false -%}
      <span class="mm-pc__badge mm-pc__badge--out">Agotado</span>
    {%- elsif on_sale -%}
      <span class="mm-pc__badge">Sale</span>
    {%- endif -%}
  </div>

  <div class="mm-pc__info">
    <div class="mm-pc__text">
      <a class="mm-pc__name" href="{{ product.url }}" data-mm-pc-link>{{ product.title | escape }}</a>
      <p class="mm-pc__price">
        {{ price | money_without_trailing_zeros }}
        {%- if on_sale -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
      </p>
      {%- if n > 1 -%}
        <p class="mm-pc__line">{{ n }} cuotas sin interés de <strong>{{ cuota | money_without_trailing_zeros }}</strong></p>
      {%- endif -%}
      {%- if pct > 0 -%}
        <p class="mm-pc__line mm-pc__line--transfer"><strong>{{ transfer | money_without_trailing_zeros }}</strong> con transferencia</p>
      {%- endif -%}
    </div>

    {%- if color_opt and color_opt.values.size > 0 -%}
      <ul class="mm-pc__colors list-unstyled" role="list" aria-label="Colores">
        {%- for value in color_opt.values limit: 5 -%}
          {%- liquid
            assign key = value | downcase | strip
            capture bg
              render 'maramour-color-bg', product: product, value: value
            endcapture
            assign bg = bg | strip

            # Primera variante disponible de ese color
            assign color_variant = ''
            for v in product.variants
              if v.options[color_index] == value
                if color_variant == blank or v.available
                  assign color_variant = v
                endif
                if v.available
                  break
                endif
              endif
            endfor
          -%}
          <li>
            <button
              type="button"
              class="mm-pc__color{% if key == active %} is-active{% endif %}"
              style="--mm-sw: {{ bg | default: '#ddd' }};"
              title="{{ value | escape }}"
              aria-label="{{ value | escape }}"
              aria-pressed="{% if key == active %}true{% else %}false{% endif %}"
              data-mm-pc-key="{{ key | escape }}"
              {% if color_variant != blank %}data-mm-pc-url="{{ color_variant.url }}"{% endif %}
            ></button>
          </li>
        {%- endfor -%}
        {%- if color_opt.values.size > 5 -%}
          <li class="mm-pc__more">+{{ color_opt.values.size | minus: 5 }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</article>
