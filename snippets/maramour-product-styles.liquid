{%- comment -%}
  MARAMOUR — Estilos de la página de producto (selector de color y talle, título, precio, botón).
  Solo CSS: se compila en el stylesheet del tema. Se renderiza desde el bloque «Ayuda con el talle».
{%- endcomment -%}

{% stylesheet %}
  /* ---------- Título y precio ---------- */
  .product-details .mm-pdp-title,
  .product-details .text-block h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .product-details product-price .price {
    font-size: 1rem;
    font-weight: 700;
  }

  /* ---------- Galería (celular): sin puntos, barra de progreso de borde a borde ---------- */
  .mm-gallery-bar {
    position: relative;
    height: 2px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-gallery-bar span {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(100% / var(--mm-n, 1));
    background: var(--color-foreground);
    transition: transform 0.12s linear;
    will-change: transform;
  }

  @media screen and (max-width: 749px) {
    media-gallery .media-gallery__mobile-controls {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    .mm-gallery-bar {
      display: none;
    }
  }

  /* ---------- Variantes (estilo «Suave»): «Color: …» / «Talle: …» arriba de cada fila ---------- */
  .variant-option.mm-opt {
    --variant-min-width: 0px;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mm-opt > legend {
    float: left;
    flex: 0 0 100%;
    width: 100%;
    margin: 0 0 2px;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .mm-opt__name {
    font-weight: 600;
  }

  .mm-opt__value {
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .mm-opt .variant-option__button-label {
    position: relative;
    flex: 0 0 auto;
    min-width: 0 !important;
    padding: 0;
    border: 0;
    background: transparent !important;
    overflow: visible;
    cursor: pointer;
  }

  .mm-opt .variant-option__button-label::before,
  .mm-opt .variant-option__button-label::after,
  .mm-opt .variant-option__button-label__pill,
  .mm-opt .variant-option__strikethrough {
    display: none !important;
  }

  /* Color: cuadraditos redondeados con el color real; el elegido con un aro negro separado */
  .mm-opt--color .variant-option__button-label {
    width: 30px;
    height: 30px;
    min-height: 0;
    border-radius: 6px !important;
    box-shadow: none !important;
    transition: box-shadow 0.15s ease;
  }

  .mm-opt--color .variant-option__button-label__text {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-size: 0;
    background: var(--mm-sw, #ddd);
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
  }

  .mm-opt--color .variant-option__button-label:has(:checked) {
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--color-foreground) !important;
  }

  .mm-opt--color .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    background:
      linear-gradient(to top right, transparent calc(50% - 0.75px), rgb(255 255 255 / 0.95) calc(50% - 0.75px), rgb(255 255 255 / 0.95) calc(50% + 0.75px), transparent calc(50% + 0.75px)),
      var(--mm-sw, #ddd);
    opacity: 0.45;
  }

  /* Talle: píldoras gris claro del mismo ancho; la elegida en negro; agotado tachado */
  .mm-opt--text {
    flex-wrap: wrap;
    gap: 8px;
  }

  .mm-opt--text .variant-option__button-label {
    display: grid;
    place-items: center;
    flex: 1 1 0;
    max-width: 64px;
    height: 36px;
    min-height: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-foreground) !important;
    background: #f4f4f4 !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mm-opt--text .variant-option__button-label__text {
    color: inherit !important;
  }

  .mm-opt--text .variant-option__button-label:hover {
    background: #ebebeb !important;
  }

  .mm-opt--text .variant-option__button-label:has(:checked) {
    color: #fff !important;
    font-weight: 600;
    background: var(--color-foreground) !important;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) {
    color: rgb(var(--color-foreground-rgb) / 0.3) !important;
    background: #f7f7f7 !important;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .mm-opt .variant-option__button-label:has(:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .mm-opt input[type='radio'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* ---------- Botón de compra (sin selector de cantidad: una prenda por vez) ---------- */
  .product-details quantity-selector-component,
  .product-details .quantity-selector-wrapper {
    display: none !important;
  }

  .product-details .add-to-cart-button {
    min-height: 52px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .product-details .add-to-cart-button .svg-wrapper {
    display: none;
  }
  /* ---------- Reseñas (Judge.me): colores y tipografía de la marca ---------- */
  .jm-review-widget {
    --jm-review-widget-button-color: #111111 !important;
    --jm-review-widget-button-text-color: #ffffff !important;
    --jm-review-widget-form-button-color: #111111 !important;
    --jm-review-widget-form-button-text-color: #ffffff !important;
    --jm-review-widget-star-and-histogram-color: #c2416c !important;
    --jm-review-widget-text-color: var(--color-foreground) !important;
    --jm-review-widget-lighter-text-color: rgb(var(--color-foreground-rgb) / 0.6) !important;

    font-family: inherit;
  }

  .jm-review-widget .jm-review-widget-minimal-header__title {
    font-size: 1.3125rem !important;
    font-weight: 600 !important;
  }

  .jm-review-widget .jm-button {
    min-height: 48px;
    padding-inline: 24px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .jdgm-horizon-widget {
    padding-block: 8px 24px;
  }
{% endstylesheet %}
