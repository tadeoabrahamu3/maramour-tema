{%- comment -%}
  MARAMOUR — Estilos de la página de producto (selector de color y talle, título, precio, botón).
  Solo CSS: se compila en el stylesheet del tema. Se renderiza desde el bloque «Ayuda con el talle».
{%- endcomment -%}

{% stylesheet %}
  /* ---------- Título y precio ---------- */
  .product-details .mm-pdp-title,
  .product-details .text-block h1 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .product-details product-price .price {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  /* ---------- Color: muestras cuadradas con el color real ---------- */
  .mm-opt legend {
    margin-bottom: 10px;
    font-size: 0.8125rem;
  }

  .mm-opt__value {
    margin-inline-start: 4px;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .mm-opt__value::before {
    content: '· ';
  }

  .variant-option.mm-opt {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .variant-option.mm-opt {
    --variant-min-width: 0px;
  }

  .mm-opt .variant-option__button-label {
    flex: 0 0 auto;
    min-width: 0 !important;
    border: 0;
    border-radius: 0;
    background: none;
    overflow: visible;
  }

  .mm-opt .variant-option__button-label::before,
  .mm-opt .variant-option__button-label::after,
  .mm-opt .variant-option__button-label__pill,
  .mm-opt .variant-option__strikethrough {
    display: none !important;
  }

  .mm-opt--color .variant-option__button-label {
    width: 28px;
    height: 28px;
    padding: 0;
    background: var(--mm-sw, #ddd);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .mm-opt--color .variant-option__button-label__text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .mm-opt--color .variant-option__button-label:has(:checked) {
    outline: 1px solid var(--color-foreground);
    outline-offset: 3px;
  }

  /* Color sin stock en ningún talle: diagonal */
  .mm-opt--color .variant-option__button-label:has([data-option-available='false']) {
    background:
      linear-gradient(to top right, transparent calc(50% - 0.75px), rgb(255 255 255 / 0.9) calc(50% - 0.75px), rgb(255 255 255 / 0.9) calc(50% + 0.75px), transparent calc(50% + 0.75px)),
      var(--mm-sw, #ddd);
    opacity: 0.55;
  }

  /* ---------- Talle: texto, elegido subrayado, agotado tachado ---------- */
  .variant-option.mm-opt--text {
    gap: 4px 18px;
  }

  .mm-opt--text .variant-option__button-label {
    padding: 6px 2px;
    font-size: 0.875rem;
    color: var(--color-foreground);
  }

  .mm-opt--text .variant-option__button-label__text {
    position: relative;
  }

  .mm-opt--text .variant-option__button-label:has(:checked),
  .mm-opt--text .variant-option__button-label:has(:checked) .variant-option__button-label__text {
    color: var(--color-foreground);
  }

  .mm-opt--text .variant-option__button-label:has(:checked) .variant-option__button-label__text {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) {
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']:checked) .variant-option__button-label__text {
    color: var(--color-foreground);
    text-decoration: line-through underline;
  }

  /* ---------- Botón de compra (sin selector de cantidad: una prenda por vez) ---------- */
  .product-details quantity-selector-component,
  .product-details .quantity-selector-wrapper {
    display: none !important;
  }

  .product-details .add-to-cart-button {
    min-height: 52px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .product-details .add-to-cart-button .svg-wrapper {
    display: none;
  }
{% endstylesheet %}
