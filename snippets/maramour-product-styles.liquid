{%- comment -%}
  MARAMOUR — Estilos de la página de producto (selector de color y talle, título, precio, botón).
  Solo CSS: se compila en el stylesheet del tema. Se renderiza desde el bloque «Ayuda con el talle».
{%- endcomment -%}

{% stylesheet %}
  /* ---------- Título y precio ---------- */
  .product-details .mm-pdp-title,
  .product-details .text-block h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .product-details product-price .price {
    font-size: 1rem;
    font-weight: 700;
  }

  /* ---------- Galería (celular): sin puntos, barra de progreso de borde a borde ---------- */
  .mm-gallery-bar {
    position: relative;
    height: 2px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-gallery-bar span {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(100% / var(--mm-n, 1));
    background: var(--color-foreground);
    transition: transform 0.12s linear;
    will-change: transform;
  }

  @media screen and (max-width: 749px) {
    media-gallery .media-gallery__mobile-controls {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    .mm-gallery-bar {
      display: none;
    }
  }

  /* ---------- Variantes (estilo «Editorial en texto»): sin cajas; lo elegido en negrita y subrayado ---------- */
  .variant-option.mm-opt {
    --variant-min-width: 0px;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mm-opt > legend {
    float: left;
    flex: 0 0 100%;
    width: 100%;
    margin: 0 0 4px;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .mm-opt__value {
    display: none;
  }

  .mm-opt .variant-option__button-label {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 7px;
    min-width: 0 !important;
    min-height: 0;
    height: auto;
    padding: 6px 0 5px;
    color: rgb(var(--color-foreground-rgb) / 0.55) !important;
    background: transparent !important;
    border: 0;
    border-radius: 0 !important;
    box-shadow: none !important;
    overflow: visible;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .mm-opt .variant-option__button-label::before,
  .mm-opt .variant-option__button-label::after,
  .mm-opt .variant-option__button-label__pill,
  .mm-opt .variant-option__strikethrough {
    display: none !important;
  }

  .mm-opt .variant-option__button-label__text {
    color: inherit !important;
  }

  .mm-opt .variant-option__button-label:hover {
    color: var(--color-foreground) !important;
  }

  /* Subrayado de lo elegido */
  .mm-opt .variant-option__button-label:has(:checked) {
    color: var(--color-foreground) !important;
    font-weight: 600;
  }

  .mm-opt .variant-option__button-label:has(:checked)::after {
    content: '';
    display: block !important;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--color-foreground);
  }

  /* Color: puntito con el color real + nombre */
  .mm-opt--color .variant-option__button-label {
    font-size: 0.875rem;
  }

  .mm-opt--color .variant-option__button-label::before {
    content: '';
    display: block !important;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    background: var(--mm-sw, #ddd);
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .mm-opt--color .variant-option__button-label:has([data-option-available='false']) {
    color: rgb(var(--color-foreground-rgb) / 0.3) !important;
  }

  .mm-opt--color .variant-option__button-label:has([data-option-available='false'])::before {
    opacity: 0.4;
  }

  /* Talle: letras sueltas; agotado gris tachado */
  .mm-opt--text {
    gap: 6px 0;
    justify-content: space-between;
    max-width: 320px;
  }

  .mm-opt--text .variant-option__button-label {
    justify-content: center;
    min-width: 28px !important;
    font-size: 0.9375rem;
    color: var(--color-foreground) !important;
  }

  .mm-opt--text .variant-option__button-label:has(:checked) {
    font-weight: 700;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) {
    color: rgb(var(--color-foreground-rgb) / 0.28) !important;
    font-weight: 400;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .mm-opt .variant-option__button-label:has(:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .mm-opt input[type='radio'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* ---------- Botón de compra (sin selector de cantidad: una prenda por vez) ---------- */
  .product-details quantity-selector-component,
  .product-details .quantity-selector-wrapper {
    display: none !important;
  }

  .product-details .add-to-cart-button {
    min-height: 52px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .product-details .add-to-cart-button .svg-wrapper {
    display: none;
  }
  /* ---------- Reseñas (Judge.me): colores y tipografía de la marca ---------- */
  .jm-review-widget {
    --jm-review-widget-button-color: #111111 !important;
    --jm-review-widget-button-text-color: #ffffff !important;
    --jm-review-widget-form-button-color: #111111 !important;
    --jm-review-widget-form-button-text-color: #ffffff !important;
    --jm-review-widget-star-and-histogram-color: #c2416c !important;
    --jm-review-widget-text-color: var(--color-foreground) !important;
    --jm-review-widget-lighter-text-color: rgb(var(--color-foreground-rgb) / 0.6) !important;

    font-family: inherit;
  }

  .jm-review-widget .jm-review-widget-minimal-header__title {
    font-size: 1.3125rem !important;
    font-weight: 600 !important;
  }

  .jm-review-widget .jm-button {
    min-height: 48px;
    padding-inline: 24px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .jdgm-horizon-widget {
    padding-block: 8px 24px;
  }
{% endstylesheet %}
