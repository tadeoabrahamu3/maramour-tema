{%- comment -%}
  MARAMOUR — Estilos de la página de producto (selector de color y talle, título, precio, botón).
  Solo CSS: se compila en el stylesheet del tema. Se renderiza desde el bloque «Ayuda con el talle».
{%- endcomment -%}

{% stylesheet %}
  /* ---------- Título y precio ---------- */
  .product-details .mm-pdp-title,
  .product-details .text-block h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .product-details product-price .price {
    font-size: 1rem;
    font-weight: 700;
  }

  /* ---------- Galería (celular): sin puntos, barra de progreso de borde a borde ---------- */
  .mm-gallery-bar {
    position: relative;
    height: 2px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-gallery-bar span {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(100% / var(--mm-n, 1));
    background: var(--color-foreground);
    transition: transform 0.12s linear;
    will-change: transform;
  }

  @media screen and (max-width: 749px) {
    media-gallery .media-gallery__mobile-controls {
      display: none !important;
    }
  }

  @media screen and (min-width: 750px) {
    .mm-gallery-bar {
      display: none;
    }
  }

  /* ---------- Variantes (sin títulos «Color» / «Talle»: se sobreentienden) ---------- */
  .mm-opt > legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .variant-option.mm-opt {
    --variant-min-width: 0px;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .mm-opt .variant-option__button-label {
    flex: 0 0 auto;
    min-width: 0 !important;
    padding: 0;
    border: 0;
    background: transparent !important;
    overflow: visible;
  }

  .mm-opt .variant-option__button-label::before,
  .mm-opt .variant-option__button-label::after,
  .mm-opt .variant-option__button-label__pill,
  .mm-opt .variant-option__strikethrough {
    display: none !important;
  }

  /* Color: círculos con el color real; el elegido con un anillo separado */
  .mm-opt--color .variant-option__button-label {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    min-height: 0;
    max-height: 32px;
    aspect-ratio: 1;
    align-self: center;
    border-radius: 50% !important;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }

  .mm-opt--color .variant-option__button-label::marker {
    content: none;
  }

  .mm-opt--color .variant-option__button-label__text {
    position: absolute;
    inset: 3px;
    overflow: hidden;
    font-size: 0;
    border-radius: 50%;
    background: var(--mm-sw, #ddd);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .mm-opt--color .variant-option__button-label:not(:has(:checked)) {
    box-shadow: none;
  }

  .mm-opt--color .variant-option__button-label:not(:has(:checked)) .variant-option__button-label__text {
    inset: 2px;
  }

  .mm-opt--color .variant-option__button-label:has(:checked) {
    box-shadow: inset 0 0 0 1.5px var(--color-foreground);
  }

  /* Color sin stock para el talle elegido: más claro con diagonal */
  .mm-opt--color .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    background:
      linear-gradient(to top right, transparent calc(50% - 0.75px), rgb(255 255 255 / 0.95) calc(50% - 0.75px), rgb(255 255 255 / 0.95) calc(50% + 0.75px), transparent calc(50% + 0.75px)),
      var(--mm-sw, #ddd);
    opacity: 0.5;
  }

  /* Talle: texto; el elegido dentro de un círculo; agotado gris y tachado */
  .mm-opt--text .variant-option__button-label {
    display: grid;
    place-items: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    min-height: 0;
    border-radius: 50% !important;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-foreground) !important;
  }

  .mm-opt--text .variant-option__button-label__text {
    color: inherit !important;
  }

  .mm-opt--text .variant-option__button-label:has(:checked) {
    box-shadow: inset 0 0 0 1px var(--color-foreground);
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) {
    color: rgb(var(--color-foreground-rgb) / 0.38) !important;
    font-weight: 400;
  }

  .mm-opt--text .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .mm-opt--text .variant-option__button-label:has(:focus-visible) {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  /* ---------- Botón de compra (sin selector de cantidad: una prenda por vez) ---------- */
  .product-details quantity-selector-component,
  .product-details .quantity-selector-wrapper {
    display: none !important;
  }

  .product-details .add-to-cart-button {
    min-height: 52px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .product-details .add-to-cart-button .svg-wrapper {
    display: none;
  }
  /* ---------- Reseñas (Judge.me): colores y tipografía de la marca ---------- */
  .jm-review-widget {
    --jm-review-widget-button-color: #111111 !important;
    --jm-review-widget-button-text-color: #ffffff !important;
    --jm-review-widget-form-button-color: #111111 !important;
    --jm-review-widget-form-button-text-color: #ffffff !important;
    --jm-review-widget-star-and-histogram-color: #c2416c !important;
    --jm-review-widget-text-color: var(--color-foreground) !important;
    --jm-review-widget-lighter-text-color: rgb(var(--color-foreground-rgb) / 0.6) !important;

    font-family: inherit;
  }

  .jm-review-widget .jm-review-widget-minimal-header__title {
    font-size: 1.3125rem !important;
    font-weight: 600 !important;
  }

  .jm-review-widget .jm-button {
    min-height: 48px;
    padding-inline: 24px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 4px;
  }

  .jdgm-horizon-widget {
    padding-block: 8px 24px;
  }
{% endstylesheet %}
