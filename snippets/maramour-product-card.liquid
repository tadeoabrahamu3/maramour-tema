{%- doc -%}
  MARAMOUR — Tarjeta de producto (Home, recomendaciones y tienda).
  Foto principal + segunda foto al pasar el mouse (del mismo color: la 2ª foto del producto),
  etiqueta Sale, nombre en mayúsculas y precio sin decimales.
  La proporción la define el contenedor con --mm-card-ratio (por defecto 2:3).

  @param {object} product - Producto
  @param {boolean} [show_second_image] - Segunda foto al pasar el mouse
  @param {boolean} [show_sale_badge] - Etiqueta «Sale»
  @param {string} [sizes] - Atributo sizes de la imagen
  @param {string} [loading] - 'lazy' (por defecto) o 'eager'
{%- enddoc -%}

{%- liquid
  assign first = product.featured_media
  assign second = product.media[1]
  assign img_sizes = sizes | default: '(min-width: 990px) 22vw, 60vw'
  assign img_loading = loading | default: 'lazy'
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<a class="mm-card" href="{{ product.url }}">
  <div class="mm-card__media">
    {%- if first -%}
      {{
        first.preview_image
        | image_url: width: 900
        | image_tag:
          loading: img_loading,
          widths: '240, 360, 480, 640, 900',
          sizes: img_sizes,
          class: 'mm-card__img',
          alt: product.title
      }}
      {%- if second and show_second_image -%}
        {{
          second.preview_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '240, 360, 480, 640, 900',
            sizes: img_sizes,
            class: 'mm-card__img mm-card__img--second',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'mm-card__img' }}
    {%- endif -%}
    {%- if on_sale and show_sale_badge -%}
      <span class="mm-card__badge">Sale</span>
    {%- endif -%}
  </div>
  <p class="mm-card__name">{{ product.title | escape }}</p>
  <p class="mm-card__price">
    {%- if on_sale -%}
      <s class="mm-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
    {%- endif -%}
    <span>{% if product.price_varies %}Desde {% endif %}{{ product.price | money_without_trailing_zeros }}</span>
  </p>
</a>

{% stylesheet %}
  .mm-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .mm-card__media {
    position: relative;
    aspect-ratio: var(--mm-card-ratio, 2 / 3);
    overflow: hidden;
    background: #f2f2f2;
  }

  .mm-card__img,
  .mm-card__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-card__media svg {
    background: #f2f2f2;
    fill: rgb(0 0 0 / 0.25);
  }

  .mm-card__img--second {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  @media (hover: hover) {
    .mm-card:hover .mm-card__img--second {
      opacity: 1;
    }
  }

  .mm-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: #111;
  }

  .mm-card__name {
    margin: 12px 0 4px;
    font-size: 0.75rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mm-card__price {
    display: flex;
    gap: 8px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .mm-card__compare {
    font-weight: 400;
    opacity: 0.55;
  }
{% endstylesheet %}
