{%- doc -%}
  MARAMOUR — Botón flotante de WhatsApp (toda la web, abajo a la derecha).
  Rosa claro de la marca (#F9E3E8) con el ícono en blanco; visible desde que carga la página.
  Mensaje general para toda la web.
  Sube cuando aparece la barra fija de «Agregar al carrito» y se oculta con los paneles abiertos.
  Sin apps ni scripts: un enlace con el ícono dibujado en SVG.
{%- enddoc -%}

{%- liquid
  assign wa_number = '5492236685697'
  assign wa_text = '¡Hola! Tengo una consulta.'
-%}

<a
  class="mm-wa"
  href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}"
  target="_blank"
  rel="noopener"
  aria-label="Escribinos por WhatsApp"
>
  <span class="mm-wa__tip" aria-hidden="true">¿Te ayudamos?</span>
  <span class="mm-wa__btn">
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M16 4.5C9.6 4.5 4.5 9.6 4.5 15.9c0 2.2.6 4.2 1.7 6L4.6 27.4l5.7-1.5a11.4 11.4 0 0 0 5.7 1.5c6.4 0 11.5-5.1 11.5-11.5S22.4 4.5 16 4.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M12.3 10.6c-.4 0-.9.2-1.2.6-.4.5-1 1.3-1 2.6 0 1.4 1 2.8 1.2 3 .1.2 2 3.2 5 4.4 2.5 1 3 .8 3.6.7.6-.1 1.8-.7 2-1.5.3-.7.3-1.3.2-1.5-.1-.1-.3-.2-.6-.4l-2.1-1c-.3-.1-.5-.2-.7.1l-1 1.2c-.2.2-.4.2-.7.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6Z" fill="currentColor"/>
    </svg>
  </span>
</a>

<style>
  .mm-wa {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: bottom 0.25s ease, opacity 0.2s ease;
  }

  .mm-wa__btn {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    color: #fff;
    background: #f9e3e8;
    border-radius: 50%;
    box-shadow: 0 6px 18px rgb(122 30 62 / 0.22), inset 0 0 0 1px rgb(194 65 108 / 0.12);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .mm-wa__btn svg {
    width: 28px;
    height: 28px;
    /* sombra mínima para que el blanco se lea sobre el rosa claro */
    filter: drop-shadow(0 1px 1.5px rgb(194 65 108 / 0.45));
  }

  .mm-wa:hover .mm-wa__btn {
    background: #f5d2db;
    transform: scale(1.05);
  }

  .mm-wa:focus-visible {
    outline: none;
  }

  .mm-wa:focus-visible .mm-wa__btn {
    box-shadow: 0 0 0 3px #fff, 0 0 0 5px #c2416c;
  }

  .mm-wa__tip {
    display: none;
    padding: 8px 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #c2416c;
    white-space: nowrap;
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.12);
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }

  @media (hover: hover) {
    .mm-wa__tip {
      display: block;
    }

    .mm-wa:hover .mm-wa__tip,
    .mm-wa:focus-visible .mm-wa__tip {
      opacity: 1;
      transform: none;
    }
  }

  /* Con la barra fija de «Agregar al carrito» visible, el botón sube para no taparla */
  body:has(.sticky-add-to-cart__bar[data-stuck='true']) .mm-wa {
    bottom: calc(96px + env(safe-area-inset-bottom));
  }

  /* Con un panel abierto (talles, filtros, carrito) no se muestra */
  html.mm-sheet-lock .mm-wa,
  body:has(dialog[open]) .mm-wa {
    opacity: 0;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .mm-wa {
      right: 24px;
      bottom: 24px;
    }

    .mm-wa__btn {
      width: 58px;
      height: 58px;
    }

    .mm-wa__btn svg {
      width: 30px;
      height: 30px;
    }

    body:has(.sticky-add-to-cart__bar[data-stuck='true']) .mm-wa {
      bottom: 104px;
    }
  }
</style>
