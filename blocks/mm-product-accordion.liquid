{%- doc -%}
  MARAMOUR — Acordeón de dudas de la página de producto (uno abierto por vez).
  1. Descripción: la descripción del producto.
  2. Composición y cuidado: metacampo custom.composicion_y_cuidado (una línea por dato) + cuidados generales.
  3. ¿Qué talle soy?: referencia de la modelo (metacampo custom.modelo), consejo y botones que
     abren los popups «Calcular mi talle» y «Tabla de talles» (bloque «Ayuda con el talle»).
  4. Envío, devoluciones y cambios: texto general.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign product = closest.product
  assign mf = product.metafields.custom
  assign composition = mf.composicion_y_cuidado.value
  assign model_info = mf.modelo.value | default: bs.model_text
-%}

<div class="mm-acc" {{ block.shopify_attributes }}>
  {%- if bs.heading != blank -%}
    <h2 class="mm-acc__heading">{{ bs.heading | escape }}</h2>
  {%- endif -%}

  {%- if product.description != blank -%}
    <details class="mm-acc__item" name="mm-pdp-acc" id="mm-acc-descripcion"{% if bs.open_first %} open{% endif %}>
      <summary class="mm-acc__q">Descripción{% render 'maramour-acc-icon' %}</summary>
      <div class="mm-acc__a mm-acc__desc rte">{{ product.description }}</div>
    </details>
  {%- endif -%}

  {%- if composition != blank or bs.care_text != blank -%}
    <details class="mm-acc__item" name="mm-pdp-acc" id="mm-acc-composicion">
      <summary class="mm-acc__q">Composición y cuidado{% render 'maramour-acc-icon' %}</summary>
      <div class="mm-acc__a rte">
        {%- if composition != blank -%}
          <ul class="mm-acc__list">
            {%- assign comp_lines = composition | newline_to_br | split: '<br />' -%}
            {%- for line in comp_lines -%}
              {%- assign l = line | strip -%}
              {%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {{ bs.care_text }}
      </div>
    </details>
  {%- endif -%}

  <details class="mm-acc__item" name="mm-pdp-acc" id="mm-acc-talles">
    <summary class="mm-acc__q">¿Qué talle soy?{% render 'maramour-acc-icon' %}</summary>
    <div class="mm-acc__a rte">
      {%- if model_info != blank -%}
        <p class="mm-acc__model">{{ model_info | escape }}</p>
      {%- endif -%}
      {{ bs.size_text }}
      <div class="mm-acc__tools">
        <button type="button" class="mm-acc__tool" data-mm-dialog="mm-size-finder">
          <span class="mm-acc__tool-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M4 16.5 16.5 4l3.5 3.5L7.5 20 4 16.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m8 12.5 1.5 1.5M10.5 10l2 2M13 7.5l1.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </span>
          <span class="mm-acc__tool-text">
            <span class="mm-acc__tool-title">Calcular mi talle</span>
            <span class="mm-acc__tool-sub">Con tu altura y peso, en segundos</span>
          </span>
          <svg class="mm-acc__tool-chev" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="mm-acc__tool" data-mm-dialog="mm-size-table">
          <span class="mm-acc__tool-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3.75" y="4.75" width="16.5" height="14.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M3.75 9.5h16.5M3.75 14.25h16.5M9.25 4.75v14.5" stroke="currentColor" stroke-width="1.5"/></svg>
          </span>
          <span class="mm-acc__tool-text">
            <span class="mm-acc__tool-title">Ver tabla de talles</span>
            <span class="mm-acc__tool-sub">Medidas de pecho, cintura y cadera</span>
          </span>
          <svg class="mm-acc__tool-chev" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </details>

  {%- if bs.shipping_text != blank -%}
    <details class="mm-acc__item" name="mm-pdp-acc" id="mm-acc-envios">
      <summary class="mm-acc__q">Envío, devoluciones y cambios{% render 'maramour-acc-icon' %}</summary>
      <div class="mm-acc__a rte">{{ bs.shipping_text }}</div>
    </details>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Descripción pegada desde otra web (Elementor, Word, etc.): se ignoran sus estilos de diseño
     para que siempre se lea como texto normal, un bloque debajo del otro */
  .mm-acc__desc div,
  .mm-acc__desc section {
    display: block !important;
    width: auto !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    position: static !important;
    transform: none !important;
    animation: none !important;
    opacity: 1 !important;
  }

  .mm-acc__desc > * + *,
  .mm-acc__desc div > * + * {
    margin-top: 12px;
  }

  .mm-acc__desc p:empty,
  .mm-acc__desc .e-n-accordion {
    display: none !important;
  }

  .mm-acc__desc ul {
    margin: 12px 0 0;
    padding-left: 18px;
  }

  .mm-acc__desc li + li {
    margin-top: 4px;
  }

  .mm-acc__heading {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 600;
  }

  .mm-acc__item {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-acc__item:first-of-type {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-acc__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 54px;
    padding-block: 14px;
    font-size: 0.875rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .mm-acc__q::-webkit-details-marker {
    display: none;
  }

  .mm-acc__icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .mm-acc__icon::before,
  .mm-acc__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 1.3px;
    background: currentColor;
    transition: transform 0.2s ease;
  }

  .mm-acc__icon::after {
    transform: rotate(90deg);
  }

  .mm-acc__item[open] .mm-acc__icon::after {
    transform: rotate(0deg);
  }

  .mm-acc__a {
    padding: 0 0 20px;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .mm-acc__a > :first-child {
    margin-top: 0;
  }

  .mm-acc__a > :last-child {
    margin-bottom: 0;
  }

  .mm-acc__list {
    margin: 0 0 12px;
    padding-inline-start: 18px;
  }

  .mm-acc__model {
    padding: 10px 12px;
    background: #f7f5f3;
    color: var(--color-foreground);
  }

  .mm-acc__table-wrap {
    overflow-x: auto;
    margin: 4px 0 8px;
  }

  .mm-acc__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    text-align: center;
    white-space: nowrap;
  }

  .mm-acc__table th,
  .mm-acc__table td {
    padding: 9px 8px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .mm-acc__table thead th {
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-foreground);
    background: #f7f5f3;
  }

  .mm-acc__table tbody th {
    font-weight: 600;
    color: var(--color-foreground);
  }

  /* «¿Qué talle soy?»: dos accesos tipo tarjeta a los popups */
  .mm-acc__tools {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }

  .mm-acc__tool {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    color: #141414;
    text-align: start;
    background: #fff;
    border: 1px solid rgb(20 20 20 / 0.14);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .mm-acc__tool:hover {
    border-color: #141414;
  }

  .mm-acc__tool:focus-visible {
    outline: 2px solid #c2416c;
    outline-offset: 2px;
  }

  .mm-acc__tool-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: #c2416c;
    background: #f9e3e8;
    border-radius: 50%;
  }

  .mm-acc__tool-icon svg {
    width: 20px;
    height: 20px;
  }

  .mm-acc__tool-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .mm-acc__tool-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .mm-acc__tool-sub {
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgb(20 20 20 / 0.62);
  }

  .mm-acc__tool-chev {
    flex: none;
    width: 18px;
    height: 18px;
    opacity: 0.55;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mm-acc__tool:hover .mm-acc__tool-chev {
    opacity: 1;
    transform: translateX(2px);
  }

  .mm-acc__note {
    font-size: 0.75rem;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Acordeón de dudas",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)" },
    { "type": "checkbox", "id": "open_first", "label": "Descripción abierta al entrar", "default": false },
    { "type": "header", "content": "Composición y cuidado" },
    { "type": "richtext", "id": "care_text", "label": "Cuidados generales", "info": "Se muestra en todos los productos, debajo de la composición de cada prenda (metacampo «Composición y cuidado»).", "default": "<p>Lavar a mano con agua fría y jabón neutro. No retorcer ni centrifugar. Secar en plano, a la sombra. No usar secadora. Planchar con paño, si es necesario. Guardar doblada, no colgada.</p>" },
    { "type": "header", "content": "¿Qué talle soy?" },
    { "type": "text", "id": "model_text", "label": "Referencia de la modelo", "default": "La modelo mide 1,66 m y usa talle S." },
    { "type": "richtext", "id": "size_text", "label": "Cómo elegir el talle", "default": "<p>Nuestros talles son reales: elegí tu talle habitual. Si estás entre dos, te recomendamos el más grande. ¿Dudas? Escribinos por WhatsApp y te asesoramos.</p>" },
    { "type": "header", "content": "Envío, devoluciones y cambios" },
    { "type": "richtext", "id": "shipping_text", "label": "Texto", "default": "<p>Envíos a todo el país en 1 a 6 días hábiles. Envío gratis desde $100.000.</p><p>Tenés 10 días desde que recibís tu compra para cambiarla o devolverla, sin uso y con etiqueta. <a href=\"/pages/politica-de-cambios\">Ver política de cambios</a>.</p>" }
  ],
  "presets": [{ "name": "Acordeón de dudas" }]
}
{% endschema %}
