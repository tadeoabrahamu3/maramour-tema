{%- doc -%}
  MARAMOUR — Debajo del botón de compra:
  - Con stock: «En stock» o, si quedan pocas, «¡Últimas N unidades!» + envío gratis.
  - Sin stock (talle/color agotado): formulario «Avisame cuando vuelva». Usa el formulario de
    cliente nativo (newsletter) con la etiqueta aviso-<id variante>-<handle>. Cuando la variante
    vuelve a tener stock, Shopify Flow le manda el mail «¡Volvió tu talle!» y borra la etiqueta.
  Se actualiza al cambiar de variante (mm-variant-sync).
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  if request.page_type == 'product' and product.selected_variant
    assign variant = product.selected_variant
  endif
  assign qty = variant.inventory_quantity
  assign tracked = false
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    assign tracked = true
  endif
  assign return_url = product.url | append: '?variant=' | append: variant.id | append: '#mm-stock-' | append: block.id
-%}

<script src="{{ 'maramour-product.js' | asset_url }}" type="module"></script>

<mm-variant-sync class="mm-stock" id="mm-stock-{{ block.id }}" data-mm-sync="stock-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if variant.available -%}
    <div class="mm-stock__row">
      {%- if tracked and qty > 0 and qty <= bs.low_stock_threshold -%}
        <p class="mm-stock__status mm-stock__status--low">
          <span class="mm-stock__dot" aria-hidden="true"></span>
          {%- if qty == 1 -%}¡Última unidad!{%- else -%}¡Últimas {{ qty }} unidades!{%- endif -%}
        </p>
      {%- else -%}
        <p class="mm-stock__status">
          <span class="mm-stock__dot" aria-hidden="true"></span>
          {{ bs.in_stock_text | escape }}
        </p>
      {%- endif -%}
      {%- if bs.shipping_text != blank -%}
        <a class="mm-stock__shipping" href="#mm-acc-envios" data-mm-open-calc>
          {{ bs.shipping_text | escape }}<span class="mm-stock__calc">Calcular envío</span>
        </a>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="mm-stock__notify">
      {%- form 'customer', return_to: return_url, class: 'mm-stock__form', data-mm-notify-form: '' -%}
        {%- if form.posted_successfully? -%}
          <p class="mm-stock__done" role="status">
            ¡Listo! Te avisamos por mail apenas vuelva a entrar en stock.
          </p>
        {%- else -%}
          <p class="mm-stock__title">{{ bs.notify_title | escape }}</p>
          <p class="mm-stock__hint">{{ bs.notify_text | escape }}</p>
          <input type="hidden" name="contact[tags]" value="aviso-{{ variant.id }}-{{ product.handle }}">
          <div class="mm-stock__field">
            <label class="visually-hidden" for="mm-stock-email-{{ block.id }}">Tu email</label>
            <input
              id="mm-stock-email-{{ block.id }}"
              type="email"
              name="contact[email]"
              placeholder="Tu email"
              autocomplete="email"
              required
            >
            <button type="submit">Avisame</button>
          </div>
          <p class="mm-stock__error" role="alert"{% unless form.errors %} hidden{% endunless %}>Revisá el email e intentá de nuevo.</p>
          <p class="mm-stock__legal">Al pedir el aviso te sumás a las novedades de Maramour. Te podés dar de baja cuando quieras.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}
</mm-variant-sync>

{%- comment -%} Popup al tocar un talle agotado (lo abre assets/maramour-product.js) {%- endcomment -%}
<dialog class="mm-sheet mm-sheet--notify" id="mm-notify" aria-labelledby="mm-notify-title" data-mm-handle="{{ product.handle }}">
  <div class="mm-sheet__panel">
    <button type="button" class="mm-sheet__close" data-mm-close aria-label="Cerrar">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
    </button>
    <div data-mm-notify-body>
      <h2 class="mm-sheet__title" id="mm-notify-title">Avisame cuando vuelva</h2>
      <p class="mm-sheet__sub">Este talle está agotado. Dejanos tu email y te escribimos apenas vuelva a entrar en stock.</p>

      <div class="mm-notify__item">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', class: 'mm-notify__img', width: 72, height: 108, data-mm-notify-img: '' }}
        {%- endif -%}
        <div>
          <p class="mm-notify__name">{{ product.title | escape }}</p>
          <p class="mm-notify__variant" data-mm-notify-variant></p>
          <p class="mm-notify__badge">Agotado</p>
        </div>
      </div>

      {%- comment -%}
        Formulario de cliente (newsletter) con la etiqueta aviso-<id variante>-<handle>.
        Shopify Flow (workflow «Aviso de stock») busca esa etiqueta cuando la variante vuelve
        a tener stock, manda el mail y después la borra.
      {%- endcomment -%}
      <script type="application/json" data-mm-notify-variants>
        [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
      </script>
      {%- assign notify_return = product.url | append: '?mm_notify=ok' -%}
      {%- form 'customer', id: 'mm-notify-form', class: 'mm-notify__form', return_to: notify_return, data-mm-notify-form: '' -%}
        <input type="hidden" name="contact[tags]" value="" data-mm-notify-field="tags">
        <label class="mm-notify__label" for="mm-notify-email">Tu email</label>
        <input class="mm-notify__input" id="mm-notify-email" type="email" name="contact[email]" placeholder="nombre@email.com" autocomplete="email" required>
        <p class="mm-stock__error" data-mm-notify-error hidden>Revisá el email e intentá de nuevo.</p>
        <button type="submit" class="mm-sheet__btn">Avisame</button>
        <p class="mm-notify__note">Al pedir el aviso te sumás a las novedades de Maramour. Te podés dar de baja cuando quieras.</p>
      {%- endform -%}
    </div>
    <div class="mm-notify__done" data-mm-notify-done hidden role="status">
      <span class="mm-notify__check" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none"><path d="M5 10.5l3.2 3.2L15 6.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <h2 class="mm-sheet__title">¡Listo!</h2>
      <p class="mm-notify__done-text">Te avisamos por mail apenas vuelva a entrar en stock.</p>
      <button type="button" class="mm-sheet__btn mm-sheet__btn--outline" data-mm-close>Seguir viendo</button>
    </div>
  </div>
</dialog>

{% stylesheet %}
  .mm-stock {
    display: block;
    font-size: 0.8125rem;
  }

  .mm-stock__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .mm-stock__status,
  .mm-stock__shipping {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .mm-stock__status {
    color: #2e7d4f;
  }

  /* «Envío gratis desde…» + «Calcular envío»: abre la calculadora del acordeón */
  a.mm-stock__shipping {
    color: inherit;
    text-decoration: none;
  }

  .mm-stock__calc {
    margin-left: 4px;
    font-weight: 600;
    color: #141414;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .mm-stock__status--low {
    padding: 3px 8px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #8f2f50;
    background: #f9e3e8;
  }

  .mm-stock__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .mm-stock__status--low .mm-stock__dot {
    animation: mm-stock-pulse 1.6s ease-in-out infinite;
  }

  @keyframes mm-stock-pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-stock__status--low .mm-stock__dot {
      animation: none;
    }
  }


  .mm-stock__notify {
    padding: 16px;
    background: #f7f7f7;
  }

  .mm-stock__title {
    margin: 0 0 2px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mm-stock__hint {
    margin: 0 0 12px;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .mm-stock__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
  }

  .mm-stock__field input {
    min-width: 0;
    height: 46px;
    padding: 0 14px;
    font: inherit;
    font-size: 1rem;
    color: inherit;
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 6px;
  }

  .mm-stock__legal {
    margin: 8px 0 0;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .mm-stock__field button {
    height: 46px;
    padding: 0 18px;
    font: inherit;
    font-weight: 600;
    color: #fff;
    background: #111;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  /* Popup «Avisame»: en compu, panel lateral como «Tabla de talles»; en celular, hoja desde abajo
     que ocupa solo lo necesario */
  @media screen and (max-width: 749px) {
    dialog.mm-sheet.mm-sheet--notify {
      inset: auto 0 0;
      width: 100%;
      max-width: none;
      height: auto !important;
      max-height: 88dvh;
      margin: 0;
      border-radius: 16px 16px 0 0;
    }

    dialog.mm-sheet.mm-sheet--notify[open] {
      animation: mm-notify-up 0.28s ease;
    }

    .mm-sheet--notify .mm-sheet__panel {
      height: auto;
      max-height: 88dvh;
      padding-top: 40px;
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
    }

    .mm-sheet--notify .mm-sheet__panel::before {
      content: '';
      position: absolute;
      top: 10px;
      left: 50%;
      width: 40px;
      height: 4px;
      background: rgb(var(--color-foreground-rgb) / 0.15);
      border-radius: 4px;
      transform: translateX(-50%);
    }

    .mm-sheet--notify .mm-sheet__close {
      top: 16px;
    }
  }

  @keyframes mm-notify-up {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }

  /* Contenido del popup «Avisame» */
  .mm-notify__item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 14px;
    align-items: center;
    margin: 6px 0 24px;
    padding: 12px;
    background: #f7f7f7;
    border-radius: 8px;
  }

  .mm-notify__img {
    display: block;
    width: 72px;
    height: 108px;
    object-fit: cover;
    border-radius: 4px;
  }

  .mm-notify__name {
    margin: 0 0 4px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .mm-notify__variant {
    margin: 0 0 8px;
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .mm-notify__badge {
    display: inline-block;
    margin: 0;
    padding: 3px 8px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8f2f50;
    background: #f9e3e8;
    border-radius: 3px;
  }

  .mm-notify__label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .mm-notify__input {
    width: 100%;
    height: 50px;
    padding: 0 14px;
    font: inherit;
    font-size: 1rem;
    color: var(--color-foreground);
    background: #fff;
    border: 1px solid #dcdcdc;
    border-radius: 4px;
  }

  .mm-notify__input:focus {
    border-color: var(--color-foreground);
    outline: none;
  }

  .mm-notify__form .mm-sheet__btn {
    margin-top: 14px;
  }

  .mm-notify__note {
    margin: 12px 0 0;
    font-size: 0.75rem;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .mm-notify__done {
    padding-top: 24px;
    text-align: center;
  }

  .mm-notify__check {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 16px;
    color: #fff;
    background: #c2416c;
    border-radius: 50%;
  }

  .mm-notify__check svg {
    width: 26px;
    height: 26px;
  }

  .mm-notify__done-text {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #c2416c;
  }

  .mm-sheet__btn--outline {
    color: var(--color-foreground) !important;
    background: transparent !important;
    border: 1px solid var(--color-foreground) !important;
  }

  .mm-stock__done {
    margin: 0;
    font-weight: 600;
    color: #c2416c;
  }

  .mm-stock__error[hidden],
  .mm-stock__done[hidden] {
    display: none;
  }

  .mm-stock__error {
    margin: 8px 0 0;
    color: #b3261e;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stock y envío",
  "tag": null,
  "settings": [
    { "type": "text", "id": "in_stock_text", "label": "Texto con stock", "default": "En stock" },
    { "type": "range", "id": "low_stock_threshold", "label": "Mostrar «Últimas unidades» con", "min": 1, "max": 10, "step": 1, "unit": "u.", "default": 3, "info": "Se muestra cuando quedan esta cantidad o menos." },
    { "type": "text", "id": "shipping_text", "label": "Texto de envío", "default": "Envío gratis desde $100.000" },
    { "type": "header", "content": "Sin stock" },
    { "type": "text", "id": "notify_title", "label": "Título", "default": "Este talle está agotado" },
    { "type": "text", "id": "notify_text", "label": "Texto", "default": "Dejanos tu email y te avisamos cuando vuelva." }
  ],
  "presets": [{ "name": "Stock y envío" }]
}
{% endschema %}
