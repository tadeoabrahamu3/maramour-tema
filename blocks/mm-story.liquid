{%- doc -%}
  MARAMOUR — «Visto en Instagram»: video vertical del producto con formato de historia.
  Video: metacampo del producto custom.video_historia (archivo de video). Si el producto no tiene,
  se usa el video general del bloque; si tampoco hay, el bloque no se muestra.
  Rendimiento: en la página solo se carga la miniatura. El video se inserta y descarga recién
  cuando la clienta toca la burbuja.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign product = closest.product
  assign video = product.metafields.custom.video_historia.value | default: bs.fallback_video
  assign poster = video.preview_image
  assign uid = 'mm-story-' | append: block.id
-%}

{%- if video != blank -%}
  <div class="mm-story" data-mm-story style="--mm-story-bg: {{ bs.background | default: '#F9E3E8' }};" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <p class="mm-story__heading">{{ bs.heading | escape }}</p>
    {%- endif -%}

    <button type="button" class="mm-story__bubble" data-mm-story-open aria-haspopup="dialog" aria-controls="{{ uid }}" aria-label="{{ bs.label | escape }}">
      <span class="mm-story__card">
        {%- if poster -%}
          {{ poster | image_url: width: 240, height: 426, crop: 'center' | image_tag: loading: 'lazy', alt: '', class: 'mm-story__thumb', width: 96, height: 171 }}
        {%- endif -%}
        <span class="mm-story__play" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="currentColor"><path d="M7 5.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L7.9 4.7a.6.6 0 0 0-.9.5Z"/></svg>
        </span>
      </span>
    </button>

    <dialog class="mm-story__dialog" id="{{ uid }}" aria-label="{{ bs.label | escape }}">
      <div class="mm-story__frame">
        <div class="mm-story__bar" aria-hidden="true"><span data-mm-story-progress></span></div>
        <div class="mm-story__top">
          <button type="button" class="mm-story__icon" data-mm-story-close aria-label="Cerrar">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
          </button>
        </div>
        <div class="mm-story__media" data-mm-story-media></div>
      </div>
    </dialog>

    <template data-mm-story-template>
      {{ video | video_tag: autoplay: false, loop: false, muted: true, controls: false, playsinline: true, preload: 'auto', class: 'mm-story__video' }}
    </template>
  </div>

  <script>
    (() => {
      const root = document.currentScript.previousElementSibling;
      if (!root || !root.matches('[data-mm-story]') || root.dataset.ready) return;
      root.dataset.ready = '1';
      const dialog = root.querySelector('dialog');
      const holder = root.querySelector('[data-mm-story-media]');
      const tpl = root.querySelector('[data-mm-story-template]');
      const bar = root.querySelector('[data-mm-story-progress]');
      let video = null;
      let raf = 0;

      const tick = () => {
        if (video && video.duration) bar.style.transform = `scaleX(${video.currentTime / video.duration})`;
        raf = requestAnimationFrame(tick);
      };

      const open = () => {
        if (!video) {
          holder.appendChild(tpl.content.cloneNode(true));
          video = holder.querySelector('video');
          video.muted = true;
          video.addEventListener('ended', close);
          video.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
        }
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        video.currentTime = 0;
        video.play().catch(() => {});
        cancelAnimationFrame(raf);
        tick();
      };

      const close = () => {
        if (video) video.pause();
        cancelAnimationFrame(raf);
        if (dialog.open) dialog.close();
      };

      root.querySelector('[data-mm-story-open]').addEventListener('click', open);
      root.querySelector('[data-mm-story-close]').addEventListener('click', close);
      dialog.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
        if (video) video.pause();
        cancelAnimationFrame(raf);
      });
      dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    })();
  </script>
{%- elsif request.design_mode -%}
  <p class="mm-story__empty" {{ block.shopify_attributes }}>
    Video historia: cargá un video en el metacampo «Video historia» del producto (o un video general en este bloque).
  </p>
{%- endif -%}

{% stylesheet %}
  .mm-story {
    padding: 16px;
    background: var(--mm-story-bg, #f9e3e8);
  }

  .mm-story__bubble:focus-visible .mm-story__card {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .mm-story__heading {
    margin: 0 0 12px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mm-story__bubble {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: start;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .mm-story__card {
    position: relative;
    flex-shrink: 0;
    width: 96px;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: #ddd;
    border-radius: 6px;
  }

  .mm-story__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-story__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.25), transparent 60%);
  }

  .mm-story__play svg {
    width: 26px;
    height: 26px;
    padding: 6px;
    background: rgb(0 0 0 / 0.35);
    border-radius: 50%;
    backdrop-filter: blur(2px);
  }

  .mm-story__dialog[open] {
    display: grid;
    place-items: center;
  }

  .mm-story__dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    color: #fff;
    background: transparent;
    border: 0;
  }

  .mm-story__dialog::backdrop {
    background: rgb(0 0 0 / 0.92);
  }

  .mm-story__frame {
    position: relative;
    display: grid;
    place-items: center;
    width: min(calc(100% - 32px), calc(88dvh * 9 / 16));
    height: auto;
    aspect-ratio: 9 / 16;
    max-height: 88dvh;
    margin: auto;
    overflow: hidden;
    background: #000;
    border-radius: 14px;
  }

  .mm-story__media,
  .mm-story__media video {
    width: 100%;
    height: 100%;
  }

  .mm-story__media video {
    object-fit: cover;
  }

  .mm-story__bar {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    z-index: 2;
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.35);
  }

  .mm-story__bar span {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .mm-story__top {
    position: absolute;
    top: 16px;
    right: 4px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 2px;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.45);
  }

  .mm-story__icon:focus:not(:focus-visible) {
    outline: none;
  }

  .mm-story__icon {
    display: grid;
    flex: 0 0 40px;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    color: #fff;
    background: none;
    border: 0;
    box-shadow: none;
    cursor: pointer;
  }

  .mm-story__icon svg {
    display: block;
    width: 22px !important;
    height: 22px !important;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.45));
  }

  .mm-story__empty {
    padding: 12px;
    font-size: 0.8125rem;
    background: #f7f5f3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video historia",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Visto en Instagram" },
    { "type": "text", "id": "label", "label": "Descripción del video (para lectores de pantalla)", "default": "Ver el video de la prenda puesta" },
    { "type": "color", "id": "background", "label": "Fondo", "default": "#F9E3E8" },
    { "type": "video", "id": "fallback_video", "label": "Video general (opcional)", "info": "Se usa en los productos que no tienen su propio video en el metacampo «Video historia»." }
  ],
  "presets": [{ "name": "Video historia" }]
}
{% endschema %}
