        "q_8": {
          "type": "question",
          "settings": {
            "question": "¿Cuáles son los métodos de pago?",
            "answer": "<p>Podés abonar mediante transferencia bancaria, tarjetas de crédito o débito, Pago Fácil, Rapipago o Mercado Pago.</p>"
          }
        },
        "q_9": {
          "type": "question",
          "settings": {
            "question": "¿Puedo pagar en cuotas?",
            "answer": "<p>Sí, podés pagar hasta en 3 cuotas sin interés. </p>"
          }
        },
