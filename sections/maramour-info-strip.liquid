{%- doc -%}
  MARAMOUR — Franja de información de compra (envíos, cuotas, transferencia, cambios).
  Vive en el grupo del footer: se ve en toda la web.
  Celular/tablet: un beneficio por vez, pasa solo (fundido), se puede deslizar o usar las flechas.
  Computadora (≥990px): los 4 en una fila, sin movimiento.
  Íconos SVG en línea (sin imágenes ni librerías), mismo trazo que los del encabezado.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
-%}

<div
  class="mm-info"
  data-mm-info
  data-interval="{{ s.interval | times: 1000 }}"
  role="region"
  aria-roledescription="carrusel"
  aria-label="Beneficios de compra"
  style="--mm-info-bg: {{ s.background }};"
>
  <button type="button" class="mm-info__arrow mm-info__arrow--prev" data-mm-info-prev aria-label="Anterior">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 5 7 10l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <ul class="mm-info__list list-unstyled" role="list">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <li class="mm-info__item{% if forloop.first %} is-active{% endif %}" data-mm-info-item {{ block.shopify_attributes }}>
        {%- if b.link != blank -%}<a class="mm-info__link" href="{{ b.link }}">{%- else -%}<div class="mm-info__link">{%- endif -%}
          <svg class="mm-info__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- case b.icon -%}
              {%- when 'truck' -%}
                <path d="M2.5 5.5h11v10h-11z"/><path d="M13.5 9h4l3.5 3.8v2.7h-7.5"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
              {%- when 'card' -%}
                <rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 9.5h19M6 15h4"/>
              {%- when 'tag' -%}
                <path d="M3 12.2V4a1 1 0 0 1 1-1h8.2a1 1 0 0 1 .7.3l8 8a1 1 0 0 1 0 1.4l-8.2 8.2a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1-.3-.7z"/><circle cx="7.5" cy="7.5" r="1.3"/>
              {%- when 'exchange' -%}
                <path d="M4 8.5h14.5L15 5M20 15.5H5.5L9 19"/>
              {%- when 'box' -%}
                <path d="M12 3 20.5 7v10L12 21l-8.5-4V7z"/><path d="M3.5 7 12 11l8.5-4M12 11v10"/>
              {%- when 'yarn' -%}
                <circle cx="12" cy="12" r="8.5"/><path d="M5 7.5c4 1 9.5 5.5 11 12M9 3.8c3.5 2.2 8 7.5 9.5 12.5M3.8 12c3 .5 7 3 8.7 8.4"/>
              {%- when 'chat' -%}
                <path d="M20.5 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.1-4.2A8.5 8.5 0 1 1 20.5 12z"/>
            {%- endcase -%}
          </svg>
          <span class="mm-info__copy">
            <span class="mm-info__name">{{ b.title | escape }}</span>
            {%- if b.text != blank -%}
              <span class="mm-info__text">{{ b.text | escape }}</span>
            {%- endif -%}
          </span>
        {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  <button type="button" class="mm-info__arrow mm-info__arrow--next" data-mm-info-next aria-label="Siguiente">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m8 5 5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-mm-info]')) return;
    const items = [...root.querySelectorAll('[data-mm-info-item]')];
    if (items.length < 2) return;

    const desktop = window.matchMedia('(min-width: 990px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const delay = Number(root.dataset.interval) || 4000;
    let index = 0;
    let timer;

    const show = (i) => {
      index = (i + items.length) % items.length;
      items.forEach((el, n) => el.classList.toggle('is-active', n === index));
    };
    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (desktop.matches || reduce.matches || document.hidden) return;
      timer = setInterval(() => show(index + 1), delay);
    };
    const step = (dir) => { show(index + dir); start(); };

    root.querySelector('[data-mm-info-prev]').addEventListener('click', () => step(-1));
    root.querySelector('[data-mm-info-next]').addEventListener('click', () => step(1));

    let x0 = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1); else start();
    }, { passive: true });

    document.addEventListener('visibilitychange', start);
    desktop.addEventListener('change', start);
    root.addEventListener('shopify:block:select', (e) => { const n = items.indexOf(e.target); if (n > -1) { show(n); stop(); } });
    start();
  })();
</script>

{% stylesheet %}
  .mm-info {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    padding: 18px 4px;
    background: var(--mm-info-bg, transparent);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .mm-info__list {
    display: grid;
    margin: 0;
  }

  /* Celular: todos en la misma celda; solo se ve el activo (la altura la da el más alto). */
  .mm-info__item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0s linear 0.5s;
  }

  .mm-info__item.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease;
  }

  .mm-info__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .mm-info__icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
  }

  .mm-info__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mm-info__name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .mm-info__text {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.68);
  }

  .mm-info__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: rgb(var(--color-foreground-rgb) / 0.5);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .mm-info__arrow svg {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .mm-info__arrow:hover {
      color: var(--color-foreground);
    }

    a.mm-info__link:hover .mm-info__name {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-info__item,
    .mm-info__item.is-active {
      transition: none;
    }
  }

  /* Computadora: los 4 en fila, sin flechas ni movimiento. */
  @media screen and (min-width: 990px) {
    .mm-info {
      display: block;
      padding: 28px var(--page-margin, 40px);
    }

    .mm-info__arrow {
      display: none;
    }

    .mm-info__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      max-width: 1200px;
      margin-inline: auto;
    }

    .mm-info__item,
    .mm-info__item.is-active {
      grid-area: auto;
      opacity: 1;
      visibility: visible;
      transition: none;
    }

    .mm-info__link {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Información de compra",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "background", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "range", "id": "interval", "label": "Tiempo entre cada beneficio (celular)", "min": 3, "max": 8, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "options": [
            { "value": "truck", "label": "Camión (envíos)" },
            { "value": "card", "label": "Tarjeta (cuotas)" },
            { "value": "tag", "label": "Etiqueta (descuento)" },
            { "value": "exchange", "label": "Flechas (cambios)" },
            { "value": "box", "label": "Caja" },
            { "value": "yarn", "label": "Ovillo" },
            { "value": "chat", "label": "Mensaje" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
        { "type": "text", "id": "text", "label": "Texto corto" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Información de compra",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Envíos a todo el país" } },
        { "type": "item", "settings": { "icon": "card", "title": "3 cuotas sin interés" } },
        { "type": "item", "settings": { "icon": "tag", "title": "10% OFF por transferencia" } },
        { "type": "item", "settings": { "icon": "exchange", "title": "Cambios en 10 días" } }
      ]
    }
  ]
}
{% endschema %}
