{%- doc -%}
  MARAMOUR — Bloque de Personalizados para la Home.
  Foto de fondo (pensada en blanco y negro) con el texto, las muestras de color y el botón encima.
  Toda la foto es tocable (lleva a la página de Personalizados). Foto opcional distinta para computadora.
  Oscurecido regulable y color de texto claro/oscuro según la foto.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign swatches = s.swatches | newline_to_br | split: '<br />'
  assign link = s.button_link | default: '/pages/personalizados'
  assign desktop_image = s.image_desktop | default: s.image
-%}

<div
  class="mm-custom mm-custom--{{ s.text_color }} mm-custom--{{ s.position }}{% if s.grayscale %} mm-custom--bw{% endif %}"
  style="--mm-custom-ratio: {{ s.image_ratio }}; --mm-custom-ratio-desktop: {{ s.image_ratio_desktop }}; --mm-custom-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="mm-custom__media" aria-hidden="true">
    {%- if s.image != blank -%}
      {%- if s.image_desktop != blank -%}
        <picture>
          <source
            media="(min-width: 990px)"
            srcset="{{ desktop_image | image_url: width: 1600 }} 1600w, {{ desktop_image | image_url: width: 2200 }} 2200w"
            sizes="100vw"
          >
          {{ s.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100', sizes: '100vw', class: 'mm-custom__img', alt: '' }}
        </picture>
      {%- else -%}
        {{ s.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1600, 2200', sizes: '100vw', class: 'mm-custom__img', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'mm-custom__img mm-custom__img--ph' }}
    {%- endif -%}
  </div>

  <div class="mm-custom__content">
    {%- if s.eyebrow != blank -%}
      <p class="mm-custom__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="mm-custom__title">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="mm-custom__text">{{ s.text }}</div>
    {%- endif -%}

    {%- if s.show_swatches and swatches.size > 0 -%}
      <ul class="mm-custom__swatches list-unstyled" role="list" aria-label="Algunos colores disponibles">
        {%- for sw in swatches -%}
          {%- assign c = sw | strip -%}
          {%- if c != blank -%}
            <li style="--sw: {{ c }};"></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <a class="mm-custom__button" href="{{ link }}">{{ s.button_label | default: 'Ver más' | escape }}</a>
  </div>
</div>

{% stylesheet %}
  .mm-custom {
    position: relative;
    display: grid;
    aspect-ratio: var(--mm-custom-ratio, 4 / 5);
    overflow: hidden;
    color: #fff;
    background: #2b2b2b;
    isolation: isolate;
  }

  .mm-custom--dark {
    color: #111;
    background: #e9e9e9;
  }

  .mm-custom__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .mm-custom__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-custom--bw .mm-custom__img {
    filter: grayscale(1);
  }

  .mm-custom__img--ph {
    fill: rgb(255 255 255 / 0.12);
  }

  .mm-custom--dark .mm-custom__img--ph {
    fill: rgb(0 0 0 / 0.15);
  }

  /* Oscurecido (o aclarado, con texto oscuro) para que el texto se lea sobre cualquier foto */
  .mm-custom__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--mm-custom-overlay, 0.3));
  }

  .mm-custom--dark .mm-custom__media::after {
    background: rgb(255 255 255 / var(--mm-custom-overlay, 0.3));
  }

  .mm-custom__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 40px var(--page-margin, 20px);
    text-align: center;
  }

  .mm-custom--bottom .mm-custom__content {
    justify-content: flex-end;
    padding-bottom: 48px;
  }

  .mm-custom--light .mm-custom__content {
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.25);
  }

  .mm-custom__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mm-custom__title {
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    color: inherit;
  }

  .mm-custom__text {
    max-width: 32ch;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .mm-custom__text p {
    margin: 0;
  }

  .mm-custom__swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 4px 0;
  }

  .mm-custom__swatches li {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.85);
  }

  .mm-custom--dark .mm-custom__swatches li {
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.2);
  }

  .mm-custom__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding-inline: 36px;
    margin-top: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #111;
    text-decoration: none;
    text-shadow: none;
    background: #fff;
    border-radius: 6px;
    transition: opacity 0.2s;
  }

  .mm-custom--dark .mm-custom__button {
    color: #fff;
    background: #111;
  }

  /* Toda la foto lleva al enlace del botón */
  .mm-custom__button::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (hover: hover) {
    .mm-custom__button:hover {
      opacity: 0.88;
    }
  }

  @media screen and (min-width: 990px) {
    .mm-custom {
      aspect-ratio: var(--mm-custom-ratio-desktop, 16 / 9);
      max-height: 85vh;
    }

    .mm-custom__content {
      gap: 14px;
      padding: 64px;
    }

    .mm-custom--bottom .mm-custom__content {
      padding-bottom: 72px;
    }

    .mm-custom__title {
      font-size: 3rem;
    }

    .mm-custom__text {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Personalizados",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Foto de fondo" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción en celular",
      "options": [
        { "value": "4 / 5", "label": "4:5" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "2 / 3", "label": "2:3" },
        { "value": "1 / 1", "label": "1:1" }
      ],
      "default": "4 / 5"
    },
    { "type": "image_picker", "id": "image_desktop", "label": "Foto para computadora (opcional)", "info": "Horizontal. Si queda vacía, se usa la misma foto recortada." },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "Proporción en computadora",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "21 / 9", "label": "21:9 (más bajo)" },
        { "value": "3 / 2", "label": "3:2 (más alto)" }
      ],
      "default": "16 / 9"
    },
    { "type": "checkbox", "id": "grayscale", "label": "Mostrar la foto en blanco y negro", "info": "Útil si la foto es a color.", "default": false },
    { "type": "range", "id": "overlay_opacity", "label": "Oscurecido de la foto", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 30 },
    {
      "type": "select",
      "id": "text_color",
      "label": "Color del texto",
      "options": [
        { "value": "light", "label": "Blanco (para fotos oscuras)" },
        { "value": "dark", "label": "Negro (para fotos claras)" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Ubicación del texto",
      "options": [
        { "value": "center", "label": "Centro" },
        { "value": "bottom", "label": "Abajo" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Texto" },
    { "type": "text", "id": "eyebrow", "label": "Texto chico superior", "default": "Hecho para vos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Personalizados" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Elegí tu modelo favorito en el color que más te guste. Lo tejemos especialmente para vos en nuestra fábrica.</p>" },
    { "type": "checkbox", "id": "show_swatches", "label": "Mostrar muestras de color", "default": true },
    { "type": "textarea", "id": "swatches", "label": "Colores (uno por línea, en formato #RRGGBB)", "default": "#F2E6D8\n#C9A27E\n#6B4A3A\n#1F1F1F\n#7C8B6F\n#B5485D\n#9DB4C8" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero el mío" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón", "info": "Si queda vacío, lleva a la página Personalizados." }
  ],
  "presets": [{ "name": "Personalizados" }]
}
{% endschema %}
