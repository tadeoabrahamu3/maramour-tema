{%- doc -%}
  MARAMOUR — Productos destacados (carrusel horizontal que se desliza con el dedo).
  Muestra los productos de una colección elegida a mano. Sin librerías: usa el desplazamiento
  nativo del navegador con «scroll-snap». Las imágenes se cargan en diferido.
  Si la colección está vacía, muestra tarjetas de ejemplo para ver el diseño.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign limit = s.limit
-%}

<div class="mm-feat" style="--mm-feat-ratio: {{ s.image_ratio }};">
  <div class="mm-feat__head">
    {%- if s.heading != blank -%}
      <h2 class="mm-feat__title">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.link_label != blank and collection != blank -%}
      <a class="mm-feat__all" href="{{ collection.url }}">{{ s.link_label | escape }}</a>
    {%- endif -%}
  </div>

  <ul class="mm-feat__track list-unstyled" role="list">
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: limit -%}
        {%- liquid
          assign first = product.featured_media
          assign second = product.media[1]
          assign on_sale = false
          if product.compare_at_price > product.price
            assign on_sale = true
          endif
        -%}
        <li class="mm-feat__item">
          <a class="mm-card" href="{{ product.url }}">
            <div class="mm-card__media{% if second and s.show_second_image %} mm-card__media--hover{% endif %}">
              {%- if first -%}
                {{
                  first.preview_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '240, 360, 480, 640, 900',
                    sizes: '(min-width: 990px) 22vw, 46vw',
                    class: 'mm-card__img',
                    alt: product.title
                }}
                {%- if second and s.show_second_image -%}
                  {{
                    second.preview_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 480, 640, 900',
                      sizes: '(min-width: 990px) 22vw, 46vw',
                      class: 'mm-card__img mm-card__img--second',
                      alt: ''
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'mm-card__img' }}
              {%- endif -%}
              {%- if on_sale and s.show_sale_badge -%}
                <span class="mm-card__badge">Sale</span>
              {%- endif -%}
            </div>
            <p class="mm-card__name">{{ product.title | escape }}</p>
            <p class="mm-card__price">
              {%- if on_sale -%}
                <s class="mm-card__compare">{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              <span>{% if product.price_varies %}Desde {% endif %}{{ product.price | money }}</span>
            </p>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li class="mm-feat__item">
          <div class="mm-card">
            <div class="mm-card__media">
              {%- capture ph -%}product-apparel-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
              {{ ph | placeholder_svg_tag: 'mm-card__img' }}
            </div>
            <p class="mm-card__name">Nombre del producto</p>
            <p class="mm-card__price"><span>$ 00.000</span></p>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .mm-feat {
    --mm-feat-gap: 8px;

    padding-block: 36px 28px;
  }

  .mm-feat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-inline: var(--page-margin, 16px);
    margin-bottom: 16px;
  }

  .mm-feat__title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .mm-feat__all {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mm-feat__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--mm-feat-gap)) / 2.2);
    gap: var(--mm-feat-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 16px);
    padding-inline: var(--page-margin, 16px);
    margin: 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .mm-feat__track::-webkit-scrollbar {
    display: none;
  }

  .mm-feat__item {
    scroll-snap-align: start;
    min-width: 0;
  }

  .mm-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .mm-card__media {
    position: relative;
    aspect-ratio: var(--mm-feat-ratio, 3 / 4);
    overflow: hidden;
    background: #f2f2f2;
  }

  .mm-card__img,
  .mm-card__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-card__media svg {
    background: #f2f2f2;
    fill: rgb(0 0 0 / 0.25);
  }

  .mm-card__img--second {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  @media (hover: hover) {
    .mm-card:hover .mm-card__img--second {
      opacity: 1;
    }
  }

  .mm-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: #111;
  }

  .mm-card__name {
    margin: 12px 0 4px;
    font-size: 0.75rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .mm-card__price {
    display: flex;
    gap: 8px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .mm-card__compare {
    font-weight: 400;
    opacity: 0.55;
  }

  @media screen and (min-width: 990px) {
    .mm-feat {
      --mm-feat-gap: 16px;

      padding-block: 56px 40px;
    }

    .mm-feat__track {
      grid-auto-columns: calc((100% - var(--mm-feat-gap) * 3) / 4);
    }

    .mm-feat__title {
      font-size: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Productos destacados",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Productos destacados" },
    { "type": "collection", "id": "collection", "label": "Colección", "info": "Cargá en esta colección los productos que quieras destacar, en el orden en que deben aparecer." },
    { "type": "range", "id": "limit", "label": "Cantidad máxima", "min": 2, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "2 / 3", "label": "2:3" },
        { "value": "4 / 5", "label": "4:5" }
      ],
      "default": "3 / 4"
    },
    { "type": "checkbox", "id": "show_second_image", "label": "Mostrar segunda foto al pasar el mouse (computadora)", "default": true },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Etiqueta «Sale» en productos rebajados", "default": true },
    { "type": "text", "id": "link_label", "label": "Texto del enlace «ver todos» (opcional)" }
  ],
  "presets": [{ "name": "Productos destacados" }]
}
{% endschema %}
