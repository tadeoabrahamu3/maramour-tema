{%- doc -%}
  MARAMOUR — Productos destacados.
  Título + «Ver todo», pestañas (Destacados y categorías) y un carrusel que se desliza con el dedo,
  con una barra de progreso debajo. Sin librerías: desplazamiento nativo con «scroll-snap» y unas
  líneas de JS para pestañas y barra. Las imágenes de las pestañas ocultas no se descargan hasta
  que se abren (carga diferida). Colecciones vacías → tarjetas de ejemplo.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign limit = s.limit
  assign sid = section.id
-%}

{%- capture placeholder_cards -%}
  {%- for i in (1..5) -%}
    <li class="mm-feat__item">
      <div class="mm-card">
        <div class="mm-card__media">
          {%- capture ph -%}product-apparel-{% cycle '1', '2', '3', '4', '1' %}{%- endcapture -%}
          {{ ph | placeholder_svg_tag: 'mm-card__img' }}
        </div>
        <p class="mm-card__name">Nombre del producto</p>
        <p class="mm-card__price"><span>$ 00.000</span></p>
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

<div class="mm-feat" data-mm-feat style="--mm-feat-ratio: {{ s.image_ratio }}; --mm-card-ratio: {{ s.image_ratio }};">
  <div class="mm-feat__head">
    {%- if s.heading != blank -%}
      <h2 class="mm-feat__title">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.link_label != blank -%}
      <a
        class="mm-feat__all"
        href="{{ s.link_url | default: routes.all_products_collection_url }}"
        data-mm-feat-all
      >
        {{- s.link_label | escape -}}
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </div>

  {%- comment -%} Pestañas: la primera es esta sección; las demás llevan a cada categoría {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <nav class="mm-feat__tabs" aria-label="Categorías">
      <span class="mm-feat__tab" aria-current="true">{{ s.main_tab_label | default: s.heading | escape }}</span>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="mm-feat__tab" href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {{- block.settings.label | default: c.title | default: 'Categoría' | escape -}}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- assign collection = s.collection -%}
  <div class="mm-feat__panel">
      <ul class="mm-feat__track list-unstyled" role="list" data-mm-feat-track>
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: limit -%}
            <li class="mm-feat__item">
              {%- render 'maramour-product-card',
                product: product,
                show_second_image: s.show_second_image,
                show_sale_badge: s.show_sale_badge,
                sizes: '(min-width: 990px) 22vw, 60vw'
              -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {{ placeholder_cards }}
        {%- endif -%}
      </ul>
  </div>

  <div class="mm-feat__progress" aria-hidden="true">
    <span class="mm-feat__progress-thumb" data-mm-feat-thumb></span>
  </div>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-mm-feat]')) return;
    const track = root.querySelector('[data-mm-feat-track]');
    const thumb = root.querySelector('[data-mm-feat-thumb]');
    if (!track || !thumb) return;

    /* Barra de progreso: el ancho muestra cuánto se ve; la posición, en qué parte del carrusel estás */
    const update = () => {
      const { scrollLeft, scrollWidth, clientWidth } = track;
      const visible = Math.min(1, clientWidth / scrollWidth);
      const max = scrollWidth - clientWidth;
      const progress = max > 0 ? scrollLeft / max : 0;
      thumb.style.width = `${visible * 100}%`;
      thumb.style.transform = `translateX(${(progress * (1 - visible) * 100) / visible}%)`;
    };

    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>

{% stylesheet %}
  .mm-feat {
    --mm-feat-gap: 8px;

    padding-block: 36px 28px;
  }

  .mm-feat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: var(--page-margin, 16px);
    margin-bottom: 14px;
  }

  .mm-feat__title {
    margin: 0;
    font-size: 1.3125rem;
    white-space: nowrap;
    font-weight: 600;
    line-height: 1.2;
  }

  .mm-feat__all {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .mm-feat__all svg {
    width: 18px;
    height: 18px;
  }

  /* Pestañas */
  .mm-feat__tabs {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-inline: var(--page-margin, 16px);
    margin-bottom: 18px;
    scrollbar-width: none;
  }

  .mm-feat__tabs::-webkit-scrollbar {
    display: none;
  }

  .mm-feat__tab {
    flex-shrink: 0;
    padding: 6px 0;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
    background: none;
    border: 0;
    border-bottom: 1.5px solid transparent;
    opacity: 0.6;
    cursor: pointer;
  }

  a.mm-feat__tab {
    text-decoration: none;
  }

  .mm-feat__tab:hover {
    opacity: 1;
  }

  .mm-feat__tab[aria-current='true'] {
    opacity: 1;
    border-bottom-color: currentColor;
  }

  /* Carrusel */
  .mm-feat__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--mm-feat-gap)) / 1.6);
    gap: var(--mm-feat-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 16px);
    padding-inline: var(--page-margin, 16px);
    margin: 0;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .mm-feat__track::-webkit-scrollbar {
    display: none;
  }

  .mm-feat__item {
    scroll-snap-align: start;
    min-width: 0;
  }

  /* Barra de progreso */
  .mm-feat__progress {
    position: relative;
    height: 2px;
    margin: 22px var(--page-margin, 16px) 0;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-feat__progress-thumb {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 40%;
    background: var(--color-foreground);
    transition: width 0.2s ease;
    will-change: transform;
  }

  @media screen and (min-width: 990px) {
    .mm-feat {
      --mm-feat-gap: 16px;

      padding-block: 56px 40px;
    }

    .mm-feat__track {
      grid-auto-columns: calc((100% - var(--mm-feat-gap) * 3) / 4);
    }

    .mm-feat__title {
      font-size: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Productos destacados",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Productos destacados" },
    { "type": "collection", "id": "collection", "label": "Colección principal", "info": "Primera pestaña. Cargá acá los productos a destacar, en el orden en que deben aparecer." },
    { "type": "text", "id": "main_tab_label", "label": "Nombre de la primera pestaña", "default": "Destacados" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver todo" },
    { "type": "url", "id": "link_url", "label": "Enlace de la primera pestaña", "info": "Las demás pestañas llevan directo a cada categoría." },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 2, "max": 12, "step": 1, "default": 5 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "2 / 3", "label": "2:3" },
        { "value": "4 / 5", "label": "4:5" }
      ],
      "default": "3 / 4"
    },
    { "type": "checkbox", "id": "show_second_image", "label": "Mostrar segunda foto al pasar el mouse (computadora)", "default": true },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Etiqueta «Sale» en productos rebajados", "default": true }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Pestaña",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "label", "label": "Nombre (opcional)", "info": "Si queda vacío, se usa el nombre de la colección." }
      ]
    }
  ],
  "presets": [{ "name": "Productos destacados" }]
}
{% endschema %}
