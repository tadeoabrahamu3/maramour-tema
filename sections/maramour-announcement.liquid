{%- doc -%}
  MARAMOUR — Franja de anuncios con texto en movimiento continuo.
  Cada bloque es un mensaje. Solo CSS (sin JavaScript): el contenido se duplica para que el
  desplazamiento sea continuo. Si el dispositivo pide reducir movimiento, el texto queda quieto.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
-%}

{%- if count > 0 -%}
  <div
    class="mm-announce"
    role="region"
    aria-label="Anuncios"
    style="--mm-announce-bg: {{ s.background }}; --mm-announce-fg: {{ s.text_color }}; --mm-announce-duration: {{ s.duration }}s;"
  >
    {%- capture messages -%}
      {%- for block in section.blocks -%}
        <span class="mm-announce__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </span>
        {%- if s.separator != blank -%}
          <span class="mm-announce__sep" aria-hidden="true">{{ s.separator | escape }}</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <div class="mm-announce__track">
      <div class="mm-announce__group">{{ messages }}</div>
      <div class="mm-announce__group" aria-hidden="true">{{ messages }}</div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mm-announce {
    overflow: hidden;
    color: var(--mm-announce-fg);
    background: var(--mm-announce-bg);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .mm-announce__track {
    display: flex;
    width: max-content;
    animation: mm-announce-scroll var(--mm-announce-duration, 30s) linear infinite;
  }

  .mm-announce:hover .mm-announce__track {
    animation-play-state: paused;
  }

  .mm-announce__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 100vw;
    justify-content: space-around;
    padding-block: 10px;
  }

  .mm-announce__item,
  .mm-announce__sep {
    padding-inline: 14px;
  }

  .mm-announce__item a {
    color: inherit;
    text-decoration: none;
  }

  @keyframes mm-announce-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-announce__track {
      animation: none;
      width: 100%;
    }

    .mm-announce__group {
      flex-wrap: wrap;
      justify-content: center;
      min-width: 0;
      white-space: normal;
      text-align: center;
    }

    .mm-announce__group[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Maramour · Anuncios",
  "tag": "aside",
  "class": "section-wrapper",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color", "id": "background", "label": "Fondo", "default": "#F9E3E8" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#111111" },
    { "type": "range", "id": "duration", "label": "Duración de una vuelta", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 28 },
    { "type": "text", "id": "separator", "label": "Separador entre mensajes", "default": "-" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Nuevo mensaje" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "Maramour · Anuncios" }]
}
{% endschema %}
