{%- doc -%}
  MARAMOUR — Lookbook: carrusel de fotos de la prenda en uso.
  Cada bloque = una foto + el producto al que lleva. El nombre y el precio se leen del producto
  (se actualizan solos si cambia el precio o entra en Sale). Se pueden ocultar si el texto ya
  viene escrito en la foto. Desplazamiento nativo, barra de progreso, imágenes en carga diferida.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
-%}

<div class="mm-look" data-mm-look style="--mm-look-ratio: {{ s.image_ratio }};">
  {%- if s.heading != blank -%}
    <div class="mm-look__head">
      <h2 class="mm-look__title">{{ s.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <ul class="mm-look__track list-unstyled" role="list" data-mm-look-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign p = block.settings.product
        assign url = p.url | default: '#'
        assign label = block.settings.label | default: p.title
      -%}
      <li class="mm-look__item" {{ block.shopify_attributes }}>
        <a class="mm-look__link" href="{{ url }}">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1200',
                sizes: '(min-width: 990px) 32vw, 86vw',
                class: 'mm-look__img',
                alt: label
            }}
          {%- else -%}
            {%- capture ph -%}lifestyle-{% cycle '1', '2', '1', '2', '1' %}{%- endcapture -%}
            {{ ph | placeholder_svg_tag: 'mm-look__img mm-look__img--ph' }}
          {%- endif -%}

          {%- if s.show_text -%}
            <span class="mm-look__caption">
              <span class="mm-look__name">{{ label | default: 'Nombre de la prenda' | escape }}</span>
              {%- if p != blank -%}
                <span class="mm-look__price">
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif -%}
                  {{- p.price | money -}}
                </span>
              {%- else -%}
                <span class="mm-look__price">$ 00.000</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>

  <div class="mm-look__progress" aria-hidden="true">
    <span class="mm-look__thumb" data-mm-look-thumb></span>
  </div>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-mm-look]')) return;
    const track = root.querySelector('[data-mm-look-track]');
    const thumb = root.querySelector('[data-mm-look-thumb]');
    if (!track || !thumb) return;
    const update = () => {
      const { scrollLeft, scrollWidth, clientWidth } = track;
      const visible = Math.min(1, clientWidth / scrollWidth);
      const max = scrollWidth - clientWidth;
      const progress = max > 0 ? scrollLeft / max : 0;
      thumb.style.width = `${visible * 100}%`;
      thumb.style.transform = `translateX(${(progress * (1 - visible) * 100) / visible}%)`;
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>

{% stylesheet %}
  .mm-look {
    --mm-look-gap: 8px;

    padding-block: 36px 40px;
  }

  .mm-look__head {
    padding-inline: var(--page-margin, 16px);
    margin-bottom: 16px;
  }

  .mm-look__title {
    margin: 0;
    font-size: 1.3125rem;
    font-weight: 600;
  }

  .mm-look__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: var(--mm-look-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin, 16px);
    padding-inline: var(--page-margin, 16px);
    margin: 0;
    scrollbar-width: none;
  }

  .mm-look__track::-webkit-scrollbar {
    display: none;
  }

  .mm-look__item {
    scroll-snap-align: start;
    min-width: 0;
  }

  .mm-look__link {
    position: relative;
    display: block;
    aspect-ratio: var(--mm-look-ratio, 3 / 4);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #ececec;
  }

  .mm-look__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mm-look__img--ph {
    fill: rgb(0 0 0 / 0.2);
  }

  .mm-look__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    padding: 40px 16px 16px;
    font-size: 0.875rem;
    line-height: 1.3;
    background: linear-gradient(to top, rgb(0 0 0 / 0.35), transparent);
  }

  .mm-look__name {
    font-style: italic;
  }

  .mm-look__price s {
    opacity: 0.7;
  }

  .mm-look__progress {
    position: relative;
    height: 2px;
    margin: 22px var(--page-margin, 16px) 0;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .mm-look__thumb {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 30%;
    background: var(--color-foreground);
    transition: width 0.2s ease;
    will-change: transform;
  }

  @media screen and (min-width: 990px) {
    .mm-look {
      --mm-look-gap: 16px;

      padding-block: 56px 56px;
    }

    .mm-look__track {
      grid-auto-columns: calc((100% - var(--mm-look-gap) * 2) / 3);
    }

    .mm-look__title {
      font-size: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)", "default": "Lookbook" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "2 / 3", "label": "2:3" }
      ],
      "default": "3 / 4"
    },
    { "type": "checkbox", "id": "show_text", "label": "Mostrar nombre y precio sobre la foto", "info": "Se toman del producto y se actualizan solos. Desactivalo solo si el texto ya está en la foto.", "default": true }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "product", "id": "product", "label": "Producto al que lleva" },
        { "type": "text", "id": "label", "label": "Nombre a mostrar (opcional)", "info": "Si queda vacío, se usa el nombre del producto." }
      ]
    }
  ],
  "presets": [
    { "name": "Lookbook", "blocks": [{ "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }] }
  ]
}
{% endschema %}
