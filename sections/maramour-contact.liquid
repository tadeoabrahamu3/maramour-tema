{%- doc -%}
  MARAMOUR — Formulario de contacto.
  Usa el formulario nativo de Shopify ({% form 'contact' %}): los mensajes llegan al
  correo remitente de la tienda (Configuración → Notificaciones → Correo electrónico del remitente).
  Sirve para «Contacto» y para «Botón de arrepentimiento» (con número de pedido).
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign form_id = 'ContactForm-' | append: section.id
  assign reasons = s.reasons | newline_to_br | split: '<br />'
-%}

<div class="section section--page-width mm-contact">
  <div class="mm-contact__inner">
    <h1 class="mm-contact__title">{{ s.heading | default: page.title | escape }}</h1>

    {%- if s.show_page_content and page.content != blank -%}
      <div class="mm-contact__intro rte">{{ page.content }}</div>
    {%- elsif s.intro != blank -%}
      <p class="mm-contact__intro">{{ s.intro }}</p>
    {%- endif -%}

    {%- form 'contact', id: form_id, class: 'mm-contact__form' -%}
      {%- liquid
        assign form_matches = false
        if form.id == form_id or form.id == blank
          assign form_matches = true
        endif
      -%}

      {%- if form.posted_successfully? and form_matches -%}
        <p class="mm-contact__notice mm-contact__notice--success" role="status" tabindex="-1" autofocus>
          {{ s.success_message }}
        </p>
      {%- elsif form.errors and form_matches -%}
        <div class="mm-contact__notice mm-contact__notice--error" role="alert" tabindex="-1" autofocus>
          Revisá los datos: {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      {%- if s.form_type != blank -%}
        <input type="hidden" name="contact[Formulario]" value="{{ s.form_type | escape }}">
      {%- endif -%}

      <div class="mm-field">
        <label for="{{ form_id }}-name">Nombre <span aria-hidden="true">*</span></label>
        <input
          type="text"
          id="{{ form_id }}-name"
          name="contact[name]"
          autocomplete="name"
          placeholder="Tu nombre"
          required
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >
      </div>

      {%- if s.show_reason and reasons.size > 0 -%}
        <div class="mm-field">
          <label for="{{ form_id }}-reason">Motivo <span aria-hidden="true">*</span></label>
          <div class="mm-select">
            <select id="{{ form_id }}-reason" name="contact[Motivo]" required>
              {%- for reason in reasons -%}
                {%- assign r = reason | strip -%}
                {%- if r != blank -%}
                  <option value="{{ r | escape }}">{{ r | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>
        </div>
      {%- endif -%}

      <div class="mm-field">
        <label for="{{ form_id }}-email">Email <span aria-hidden="true">*</span></label>
        <input
          type="email"
          id="{{ form_id }}-email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          placeholder="Tu mail"
          required
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          {% if form.errors contains 'email' and form_matches %}
            aria-invalid="true"
          {% endif %}
        >
      </div>

      {%- if s.show_order -%}
        <div class="mm-field">
          <label for="{{ form_id }}-order">Número de pedido <span aria-hidden="true">*</span></label>
          <input
            type="text"
            id="{{ form_id }}-order"
            name="contact[Número de pedido]"
            placeholder="Ej.: #1001"
            required
          >
        </div>
      {%- endif -%}

      {%- if s.show_phone -%}
        <div class="mm-field">
          <label for="{{ form_id }}-phone">Número de teléfono</label>
          <input
            type="tel"
            id="{{ form_id }}-phone"
            name="contact[phone]"
            autocomplete="tel"
            placeholder="Tu número de teléfono"
            value="{{ form.phone }}"
          >
        </div>
      {%- endif -%}

      <div class="mm-field">
        <label for="{{ form_id }}-body">
          {{ s.message_label | default: 'Mensaje' }}
          {%- if s.message_required %} <span aria-hidden="true">*</span>{% endif -%}
        </label>
        <textarea
          id="{{ form_id }}-body"
          name="contact[body]"
          rows="6"
          placeholder="{{ s.message_placeholder | escape }}"
          {% if s.message_required %}
            required
          {% endif %}
        >{{ form.body }}</textarea>
      </div>

      <p class="mm-contact__required">* Campos obligatorios</p>

      <button type="submit" class="mm-contact__submit">{{ s.button_label | default: 'Enviar' }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .mm-contact {
    padding-block: 32px 56px;
  }

  .mm-contact__inner {
    max-width: 560px;
    margin-inline: auto;
  }

  .mm-contact__title {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .mm-contact__intro {
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0 0 28px;
  }

  .mm-contact__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mm-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mm-field label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mm-field input,
  .mm-field textarea,
  .mm-field select {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    font: inherit;
    font-size: 1rem; /* 16 px: evita el zoom automático en iPhone */
    color: var(--color-foreground);
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: 6px;
    appearance: none;
  }

  .mm-field textarea {
    resize: vertical;
    min-height: 160px;
  }

  .mm-field input::placeholder,
  .mm-field textarea::placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .mm-field input:focus-visible,
  .mm-field textarea:focus-visible,
  .mm-field select:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 1px;
  }

  .mm-select {
    position: relative;
  }

  .mm-select::after {
    content: '';
    position: absolute;
    inset-inline-end: 16px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .mm-contact__required {
    font-size: 0.8125rem;
    margin: -4px 0 0;
    opacity: 0.7;
  }

  .mm-contact__submit {
    min-height: 50px;
    width: 100%;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
    background: transparent;
    border: 1px solid var(--color-foreground);
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .mm-contact__submit:hover {
    color: var(--color-background);
    background: var(--color-foreground);
  }

  .mm-contact__notice {
    padding: 14px 16px;
    font-size: 0.9375rem;
    border-radius: 6px;
  }

  .mm-contact__notice--success {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .mm-contact__notice--error {
    border: 1px solid #b42318;
    color: #b42318;
  }

  .mm-contact__notice--error ul {
    margin: 4px 0 0;
    padding-inline-start: 18px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Maramour · Formulario",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Envíanos un correo electrónico" },
    { "type": "textarea", "id": "intro", "label": "Texto de introducción", "default": "Completá el formulario y te respondemos a la brevedad." },
    { "type": "checkbox", "id": "show_page_content", "label": "Usar el contenido de la página como introducción", "default": false },
    { "type": "text", "id": "form_type", "label": "Tipo de formulario (aparece en el mail que recibís)", "default": "Contacto" },
    { "type": "checkbox", "id": "show_reason", "label": "Mostrar «Motivo»", "default": true },
    { "type": "textarea", "id": "reasons", "label": "Opciones de «Motivo» (una por línea)", "default": "Información sobre productos\nEstado de mi pedido\nCambios y devoluciones\nPersonalizados\nOtro" },
    { "type": "checkbox", "id": "show_order", "label": "Pedir número de pedido", "default": false },
    { "type": "checkbox", "id": "show_phone", "label": "Mostrar teléfono", "default": true },
    { "type": "text", "id": "message_label", "label": "Etiqueta del mensaje", "default": "Mensaje" },
    { "type": "text", "id": "message_placeholder", "label": "Texto de ayuda del mensaje", "default": "Contanos en qué te podemos ayudar" },
    { "type": "checkbox", "id": "message_required", "label": "Mensaje obligatorio", "default": true },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Enviar" },
    { "type": "textarea", "id": "success_message", "label": "Mensaje de envío correcto", "default": "¡Gracias! Recibimos tu mensaje y te respondemos a la brevedad." }
  ]
}
{% endschema %}
