{%- doc -%}
  MARAMOUR — «También te puede gustar» en la página de producto.
  Muestra los más vendidos de la tienda (o, si se elige, los relacionados de Shopify) con la misma
  tarjeta y carrusel de la Home, sin pestañas ni «Ver todo». Saltea el producto que se está viendo.
  Rendimiento: se piden al servidor recién cuando la clienta se acerca a esta parte de la página
  (no suma nada a la carga inicial).
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign product_id = product.id | default: closest.product.id
  if s.source == 'related'
    assign feed_url = routes.product_recommendations_url | append: '?product_id=' | append: product_id | append: '&limit=10&section_id=' | append: section.id | append: '&intent=related'
  else
    assign feed_url = routes.all_products_collection_url | append: '?sort_by=best-selling&section_id=maramour-best-sellers-feed'
  endif
-%}

<div
  class="mm-feat mm-recs"
  data-mm-recs
  data-url="{{ feed_url }}"
  data-product-id="{{ product_id }}"
  data-limit="{{ s.limit }}"
  style="--mm-feat-ratio: {{ s.image_ratio }}; --mm-card-ratio: {{ s.image_ratio }};"
  hidden
>
  {%- if recommendations.performed -%}
    {%- comment -%} Respuesta para el modo «relacionados»: la misma lista que devuelve la sección de más vendidos {%- endcomment -%}
    <ul class="list-unstyled" data-mm-recs-feed>
      {%- for rec in recommendations.products -%}
        <li class="mm-feat__item" data-product-id="{{ rec.id }}">
          {%- render 'maramour-product-card',
            product: rec,
            show_second_image: true,
            show_sale_badge: true,
            sizes: '(min-width: 990px) 22vw, 60vw'
          -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <div class="mm-feat__head">
      <h2 class="mm-feat__title">{{ s.heading | escape }}</h2>
    </div>
    <ul class="mm-feat__track list-unstyled" role="list" data-mm-feat-track></ul>
    <div class="mm-feat__progress" aria-hidden="true">
      <span class="mm-feat__progress-thumb" data-mm-feat-thumb></span>
    </div>
  {%- endif -%}
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-mm-recs]') || !root.querySelector('[data-mm-feat-track]')) return;
    const track = root.querySelector('[data-mm-feat-track]');
    const thumb = root.querySelector('[data-mm-feat-thumb]');
    const limit = Number(root.dataset.limit) || 7;

    const initBar = () => {
      const update = () => {
        const { scrollLeft, scrollWidth, clientWidth } = track;
        const visible = Math.min(1, clientWidth / scrollWidth);
        const max = scrollWidth - clientWidth;
        const progress = max > 0 ? scrollLeft / max : 0;
        thumb.style.width = `${visible * 100}%`;
        thumb.style.transform = `translateX(${(progress * (1 - visible) * 100) / visible}%)`;
      };
      track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    };

    const load = () =>
      fetch(root.dataset.url)
        .then((r) => (r.ok ? r.text() : Promise.reject()))
        .then((text) => {
          const html = new DOMParser().parseFromString(text, 'text/html');
          const items = [...html.querySelectorAll('[data-mm-recs-feed] > li')]
            .filter((li) => li.dataset.productId !== root.dataset.productId)
            .slice(0, limit);
          if (items.length < 2) return root.remove();
          track.replaceChildren(...items.map((li) => document.importNode(li, true)));
          root.hidden = false;
          initBar();
        })
        .catch(() => root.remove());

    if (!('IntersectionObserver' in window)) return load();
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '600px 0px' }
    );
    io.observe(root.parentElement || root);
  })();
</script>

{% stylesheet %}
  .mm-recs[hidden] {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "También te puede gustar",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "También te puede gustar" },
    {
      "type": "select",
      "id": "source",
      "label": "Productos a mostrar",
      "options": [
        { "value": "best_selling", "label": "Los más vendidos" },
        { "value": "related", "label": "Relacionados (Shopify)" }
      ],
      "default": "best_selling",
      "info": "Siempre se saltea el producto que se está viendo."
    },
    { "type": "range", "id": "limit", "label": "Cantidad de productos", "min": 2, "max": 10, "step": 1, "default": 7 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "2 / 3", "label": "2:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" }
      ],
      "default": "2 / 3"
    }
  ],
  "presets": [{ "name": "También te puede gustar" }]
}
{% endschema %}
