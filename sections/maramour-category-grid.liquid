{%- doc -%}
  MARAMOUR — Categorías en cuadrícula de 2 columnas con foto vertical y nombre encima.
  Cada bloque es una categoría (colección). Foto: la que se elija en el bloque o, si no,
  la imagen de la colección. Imágenes en carga diferida.
{%- enddoc -%}

{%- liquid
  assign s = section.settings
-%}

<div class="mm-cats" style="--mm-cats-ratio: {{ s.image_ratio }}; --mm-cats-gap: {{ s.gap }}px; --mm-cats-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};">
  {%- if s.heading != blank -%}
    <h2 class="mm-cats__title">{{ s.heading | escape }}</h2>
  {%- endif -%}

  <ul class="mm-cats__grid list-unstyled" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign label = block.settings.label | default: c.title | default: 'Categoría'
        assign img = block.settings.image | default: c.featured_image
        assign url = c.url | default: '#'
      -%}
      <li class="mm-cats__item" {{ block.shopify_attributes }}>
        <a class="mm-cats__link" href="{{ url }}">
          {%- if img != blank -%}
            {{
              img
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 990px) 25vw, 50vw',
                class: 'mm-cats__img',
                alt: label
            }}
          {%- else -%}
            {%- capture ph -%}collection-apparel-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
            {{ ph | placeholder_svg_tag: 'mm-cats__img mm-cats__img--ph' }}
          {%- endif -%}
          <span class="mm-cats__label">{{ label | escape }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .mm-cats {
    padding-block: 8px 36px;
  }

  .mm-cats__title {
    margin: 0 0 16px;
    padding-inline: var(--page-margin, 16px);
    font-size: 1.375rem;
    font-weight: 600;
  }

  .mm-cats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--mm-cats-gap, 4px);
    margin: 0;
  }

  .mm-cats__link {
    position: relative;
    display: block;
    aspect-ratio: var(--mm-cats-ratio, 2 / 3);
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #ececec;
  }

  .mm-cats__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .mm-cats__img--ph {
    fill: rgb(0 0 0 / 0.2);
  }

  .mm-cats__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--mm-cats-overlay, 0.15));
    pointer-events: none;
  }

  .mm-cats__label {
    position: absolute;
    inset: 50% 8px auto;
    z-index: 1;
    transform: translateY(-50%);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.35);
  }

  @media (hover: hover) {
    .mm-cats__link:hover .mm-cats__img {
      transform: scale(1.04);
    }
  }

  @media screen and (min-width: 990px) {
    .mm-cats {
      padding-block: 16px 56px;
    }

    .mm-cats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mm-cats__label {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Categorías",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "2 / 3", "label": "2:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" }
      ],
      "default": "2 / 3"
    },
    { "type": "range", "id": "gap", "label": "Separación entre fotos", "min": 0, "max": 16, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "overlay_opacity", "label": "Oscurecido de la foto", "min": 0, "max": 50, "step": 5, "unit": "%", "default": 15 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Si queda vacía, se usa la imagen de la colección." },
        { "type": "text", "id": "label", "label": "Nombre (opcional)", "info": "Si queda vacío, se usa el nombre de la colección." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
